{{!
    @template tiny_studiolms/popup_block_align
    @copyright 2026 Jean Lúcio

    Alignment field shared by the popups of the blocks that are narrower than the page: where the block sits in the
    row. The popup context carries the three flags from alignVars() in amd/src/blocks/block_align.js.

    Example context (json): {"alignLeft": false, "alignCenter": true, "alignRight": false}
}}
<div class="mb-3">
    <label for="pop_block_align" class="form-label small fw-bold">{{#str}} alignment, tiny_studiolms {{/str}}</label>
    <select class="form-select form-select-sm" id="pop_block_align">
        <option value="left" {{#alignLeft}}selected{{/alignLeft}}>{{#str}} align_left, tiny_studiolms {{/str}}</option>
        <option value="center" {{#alignCenter}}selected{{/alignCenter}}>{{#str}} align_center, tiny_studiolms {{/str}}</option>
        <option value="right" {{#alignRight}}selected{{/alignRight}}>{{#str}} align_right, tiny_studiolms {{/str}}</option>
    </select>
</div>
