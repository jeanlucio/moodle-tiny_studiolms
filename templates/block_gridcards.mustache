{{!
    @template tiny_studiolms/block_gridcards
    @copyright 2026 Jean Lúcio <jeanlucio@gmail.com>

    Example context (json): {
        "containerStyle": "background: #fff; border: none; border-radius: 0px; padding: 0px;",
        "containerTitle": "Grid Title", "containerTitleSize": "24px", "titleColor": "#333",
        "columns": "2", "gap": 20, "slotsHtml": "<div class=\"slms-grid-slot\"></div>"
    }
}}
<div class="studiolms-grid-wrap mceNonEditable" style="{{containerStyle}}">
    {{#containerTitle}}
        <h3 class="slms-grid-title mceEditable pb-2 mb-3 border-bottom"
            style="font-size: {{containerTitleSize}}; color: {{titleColor}}; font-weight: 700;">
            {{{containerTitle}}}
        </h3>
    {{/containerTitle}}
    <div class="studiolms-grid-content" style="--slms-gap: {{gap}}px; --slms-cols: repeat({{columns}}, 1fr);">
        {{{slotsHtml}}}
    </div>
</div>
<p><br></p>
