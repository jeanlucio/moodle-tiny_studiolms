{{!
    @template tiny_studiolms/popup_infographic_comparison_edit

    Edit popup for the StudioLMS infographic comparison block.
    Each item row has a label input and two checkboxes (one per column).
    Up to 6 criteria; blank rows are ignored on render.

    Example context (json):
    {
        "title": "Free vs Premium",
        "col1": "Free",
        "col2": "Premium",
        "item1_label": "Unlimited access",
        "item1_col1": false,
        "item1_col2": true,
        "item2_label": "Priority support",
        "item2_col1": false,
        "item2_col2": true,
        "item3_label": "Basic features",
        "item3_col1": true,
        "item3_col2": true,
        "item4_label": "",
        "item4_col1": true,
        "item4_col2": true,
        "item5_label": "",
        "item5_col1": true,
        "item5_col2": true,
        "item6_label": "",
        "item6_col1": true,
        "item6_col2": true,
        "themeBlue": true,
        "themeGreen": false,
        "themePurple": false,
        "themeOrange": false,
        "themeRed": false,
        "themeBlack": false
    }
}}
<div class="slms-popup-infographic-comparison-edit">

    {{! Optional title }}
    <div class="mb-2">
        <label for="cmp_title" class="form-label small fw-semibold">
            {{#str}}infographic_comparison_title, tiny_studiolms{{/str}}
        </label>
        <input type="text"
               id="cmp_title"
               class="form-control form-control-sm"
               value="{{title}}"
               maxlength="80"/>
    </div>

    {{! Column names }}
    <div class="d-flex mb-2" style="gap:8px;">
        <div style="flex:1;">
            <label for="cmp_col1" class="form-label small fw-semibold">
                {{#str}}infographic_comparison_col1, tiny_studiolms{{/str}}
            </label>
            <input type="text"
                   id="cmp_col1"
                   class="form-control form-control-sm"
                   value="{{col1}}"
                   maxlength="20"
                   placeholder="{{#str}}infographic_comparison_col1_ph, tiny_studiolms{{/str}}"/>
        </div>
        <div style="flex:1;">
            <label for="cmp_col2" class="form-label small fw-semibold">
                {{#str}}infographic_comparison_col2, tiny_studiolms{{/str}}
            </label>
            <input type="text"
                   id="cmp_col2"
                   class="form-control form-control-sm"
                   value="{{col2}}"
                   maxlength="20"
                   placeholder="{{#str}}infographic_comparison_col2_ph, tiny_studiolms{{/str}}"/>
        </div>
    </div>

    {{! Item rows }}
    <div class="mb-2">
        <div class="slms-cmp-header-row">
            <span class="form-label small fw-semibold slms-cmp-header-label">
                {{#str}}infographic_comparison_items, tiny_studiolms{{/str}}
            </span>
            <span class="slms-cmp-check-col slms-cmp-col-label" aria-hidden="true">A</span>
            <span class="slms-cmp-check-col slms-cmp-col-label" aria-hidden="true">B</span>
        </div>

        {{! Item 1 }}
        <div class="slms-cmp-item-row">
            <input type="text"
                   id="cmp_item1_label"
                   class="form-control form-control-sm slms-cmp-label-input"
                   value="{{item1_label}}"
                   placeholder="{{#str}}infographic_comparison_item_label_ph, tiny_studiolms{{/str}}"
                   aria-label="{{#str}}infographic_comparison_item_label, tiny_studiolms{{/str}} 1"/>
            <div class="slms-cmp-check-col">
                <input type="checkbox"
                       id="cmp_item1_col1"
                       class="slms-cmp-checkbox"
                       {{#item1_col1}}checked{{/item1_col1}}
                       aria-label="A 1"/>
            </div>
            <div class="slms-cmp-check-col">
                <input type="checkbox"
                       id="cmp_item1_col2"
                       class="slms-cmp-checkbox"
                       {{#item1_col2}}checked{{/item1_col2}}
                       aria-label="B 1"/>
            </div>
        </div>

        {{! Item 2 }}
        <div class="slms-cmp-item-row">
            <input type="text"
                   id="cmp_item2_label"
                   class="form-control form-control-sm slms-cmp-label-input"
                   value="{{item2_label}}"
                   placeholder="{{#str}}infographic_comparison_item_label_ph, tiny_studiolms{{/str}}"
                   aria-label="{{#str}}infographic_comparison_item_label, tiny_studiolms{{/str}} 2"/>
            <div class="slms-cmp-check-col">
                <input type="checkbox"
                       id="cmp_item2_col1"
                       class="slms-cmp-checkbox"
                       {{#item2_col1}}checked{{/item2_col1}}
                       aria-label="A 2"/>
            </div>
            <div class="slms-cmp-check-col">
                <input type="checkbox"
                       id="cmp_item2_col2"
                       class="slms-cmp-checkbox"
                       {{#item2_col2}}checked{{/item2_col2}}
                       aria-label="B 2"/>
            </div>
        </div>

        {{! Item 3 }}
        <div class="slms-cmp-item-row">
            <input type="text"
                   id="cmp_item3_label"
                   class="form-control form-control-sm slms-cmp-label-input"
                   value="{{item3_label}}"
                   placeholder="{{#str}}infographic_comparison_item_label_ph, tiny_studiolms{{/str}}"
                   aria-label="{{#str}}infographic_comparison_item_label, tiny_studiolms{{/str}} 3"/>
            <div class="slms-cmp-check-col">
                <input type="checkbox"
                       id="cmp_item3_col1"
                       class="slms-cmp-checkbox"
                       {{#item3_col1}}checked{{/item3_col1}}
                       aria-label="A 3"/>
            </div>
            <div class="slms-cmp-check-col">
                <input type="checkbox"
                       id="cmp_item3_col2"
                       class="slms-cmp-checkbox"
                       {{#item3_col2}}checked{{/item3_col2}}
                       aria-label="B 3"/>
            </div>
        </div>

        {{! Item 4 }}
        <div class="slms-cmp-item-row">
            <input type="text"
                   id="cmp_item4_label"
                   class="form-control form-control-sm slms-cmp-label-input"
                   value="{{item4_label}}"
                   placeholder="{{#str}}infographic_comparison_item_label_ph, tiny_studiolms{{/str}}"
                   aria-label="{{#str}}infographic_comparison_item_label, tiny_studiolms{{/str}} 4"/>
            <div class="slms-cmp-check-col">
                <input type="checkbox"
                       id="cmp_item4_col1"
                       class="slms-cmp-checkbox"
                       {{#item4_col1}}checked{{/item4_col1}}
                       aria-label="A 4"/>
            </div>
            <div class="slms-cmp-check-col">
                <input type="checkbox"
                       id="cmp_item4_col2"
                       class="slms-cmp-checkbox"
                       {{#item4_col2}}checked{{/item4_col2}}
                       aria-label="B 4"/>
            </div>
        </div>

        {{! Item 5 }}
        <div class="slms-cmp-item-row">
            <input type="text"
                   id="cmp_item5_label"
                   class="form-control form-control-sm slms-cmp-label-input"
                   value="{{item5_label}}"
                   placeholder="{{#str}}infographic_comparison_item_label_ph, tiny_studiolms{{/str}}"
                   aria-label="{{#str}}infographic_comparison_item_label, tiny_studiolms{{/str}} 5"/>
            <div class="slms-cmp-check-col">
                <input type="checkbox"
                       id="cmp_item5_col1"
                       class="slms-cmp-checkbox"
                       {{#item5_col1}}checked{{/item5_col1}}
                       aria-label="A 5"/>
            </div>
            <div class="slms-cmp-check-col">
                <input type="checkbox"
                       id="cmp_item5_col2"
                       class="slms-cmp-checkbox"
                       {{#item5_col2}}checked{{/item5_col2}}
                       aria-label="B 5"/>
            </div>
        </div>

        {{! Item 6 — optional }}
        <div class="slms-cmp-item-row">
            <input type="text"
                   id="cmp_item6_label"
                   class="form-control form-control-sm slms-cmp-label-input"
                   value="{{item6_label}}"
                   placeholder="{{#str}}infographic_comparison_item_label_ph, tiny_studiolms{{/str}}"
                   aria-label="{{#str}}infographic_comparison_item_label, tiny_studiolms{{/str}} 6"/>
            <div class="slms-cmp-check-col">
                <input type="checkbox"
                       id="cmp_item6_col1"
                       class="slms-cmp-checkbox"
                       {{#item6_col1}}checked{{/item6_col1}}
                       aria-label="A 6"/>
            </div>
            <div class="slms-cmp-check-col">
                <input type="checkbox"
                       id="cmp_item6_col2"
                       class="slms-cmp-checkbox"
                       {{#item6_col2}}checked{{/item6_col2}}
                       aria-label="B 6"/>
            </div>
        </div>
    </div>

    {{! Theme picker }}
    <div class="mb-2">
        <span class="form-label small fw-semibold d-block mb-1">
            {{#str}}infographic_theme, tiny_studiolms{{/str}}
        </span>
        <div class="d-flex align-items-center" style="gap:8px;">
            <button type="button"
                    class="slms-ig-theme-btn{{#themeBlue}} selected{{/themeBlue}}"
                    data-theme="blue"
                    aria-label="{{#str}}infographic_theme_blue, tiny_studiolms{{/str}}"
                    style="background:#1d4ed8;">
            </button>
            <button type="button"
                    class="slms-ig-theme-btn{{#themeGreen}} selected{{/themeGreen}}"
                    data-theme="green"
                    aria-label="{{#str}}infographic_theme_green, tiny_studiolms{{/str}}"
                    style="background:#15803d;">
            </button>
            <button type="button"
                    class="slms-ig-theme-btn{{#themePurple}} selected{{/themePurple}}"
                    data-theme="purple"
                    aria-label="{{#str}}infographic_theme_purple, tiny_studiolms{{/str}}"
                    style="background:#7c3aed;">
            </button>
            <button type="button"
                    class="slms-ig-theme-btn{{#themeOrange}} selected{{/themeOrange}}"
                    data-theme="orange"
                    aria-label="{{#str}}infographic_theme_orange, tiny_studiolms{{/str}}"
                    style="background:#c2410c;">
            </button>
            <button type="button"
                    class="slms-ig-theme-btn{{#themeRed}} selected{{/themeRed}}"
                    data-theme="red"
                    aria-label="{{#str}}infographic_theme_red, tiny_studiolms{{/str}}"
                    style="background:#be123c;">
            </button>
            <button type="button"
                    class="slms-ig-theme-btn{{#themeBlack}} selected{{/themeBlack}}"
                    data-theme="black"
                    aria-label="{{#str}}infographic_theme_black, tiny_studiolms{{/str}}"
                    style="background:#0f172a;">
            </button>
        </div>
    </div>

    <hr class="my-2"/>

    {{! AI generation }}
    <div>
        <span class="form-label small fw-semibold d-block mb-1">
            ✨ {{#str}}infographic_ai_section, tiny_studiolms{{/str}}
        </span>
        <textarea id="cmp_ai_prompt"
                  class="form-control form-control-sm"
                  rows="2"
                  placeholder="{{#str}}infographic_comparison_ai_prompt, tiny_studiolms{{/str}}"></textarea>
        <div class="d-flex align-items-center mt-2" style="gap:8px;">
            <button type="button" class="btn btn-sm btn-primary" id="cmp-ai-btn">
                {{#str}}infographic_ai_generate, tiny_studiolms{{/str}}
            </button>
            <div id="cmp-ai-spinner"
                 class="spinner-border spinner-border-sm text-primary d-none"
                 role="status"
                 aria-hidden="true"></div>
        </div>
        <div id="cmp-ai-error" class="text-danger small mt-1 d-none"></div>
    </div>

</div>
