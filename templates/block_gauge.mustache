{{!
    @template tiny_studiolms/block_gauge

    Gauge block — 1 to 3 SVG semi-circle gauges rendered side by side.

    Example context (json):
    {
        "title": "Desempenho da turma",
        "gauges": [
            {"svg": "<svg></svg>"},
            {"svg": "<svg></svg>"},
            {"svg": "<svg></svg>"}
        ]
    }
}}
<div class="slms-block slms-gauge-block{{#hoverEffect}} slms-hov-{{hoverEffect}}{{/hoverEffect}}">
    {{#title}}<div class="slms-gauge__title">{{title}}</div>{{/title}}
    <div class="slms-gauge__row">
        {{#gauges}}
        <div class="slms-gauge__wrap">
            {{{svg}}}
        </div>
        {{/gauges}}
    </div>
</div>
