{{!
    @template tiny_studiolms/block_infographic_timeline

    Rendered output for the StudioLMS infographic timeline block.
    The `content` variable contains pre-built HTML from the JS renderer.

    Example context (json):
    {
        "theme": "blue",
        "content": "<div class=\"slms-timeline__list\"></div>"
    }
}}
<div class="slms-block slms-infographic-timeline-block slms-infographic-timeline--{{theme}}">
    {{{content}}}
</div>
