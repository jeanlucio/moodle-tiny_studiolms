{{!
    @template tiny_studiolms/block_heading
    @copyright 2026 Jean Lúcio <jeanlucio@gmail.com>

    Example context (json): {
        "isH3": true, "isH4": false, "bgColor": "#e3f2fd", "textColor": "#0d47a1", "icon": "🎯", "text": "H"
    }
}}
<div class="studiolms-heading-wrap my-4 w-100">
    {{#isH3}}
    <h3 class="studiolms-heading-h3" style="--slms-bg: {{bgColor}}; --slms-color: {{textColor}};">
        <span contenteditable="false" aria-hidden="true" class="me-2 user-select-none">{{icon}}</span>
        <span class="slms-heading-text flex-grow-1" contenteditable="true" style="outline: none;">{{{text}}}</span>
    </h3>
    {{/isH3}}
    {{#isH4}}
    <h4 class="studiolms-heading-h4" style="--slms-bg: {{bgColor}}; --slms-color: {{textColor}};">
        <span contenteditable="false" aria-hidden="true" class="me-2 user-select-none">{{icon}}</span>
        <span class="slms-heading-text flex-grow-1" contenteditable="true" style="outline: none;">{{{text}}}</span>
    </h4>
    {{/isH4}}
</div>
<p><br></p>
