{{!
    @template tiny_studiolms/modal
    @copyright 2026 Jean Lúcio <jeanlucio@gmail.com>

    Example context (json): {}
}}
<div class="tiny_studiolms container-fluid px-0" id="studiolms-app">
    <div id="slms-view-library">
        <ul class="nav nav-tabs slms-tabs px-3 pt-2" role="tablist" aria-label="{{#str}} library, tiny_studiolms {{/str}}">
            <li class="nav-item" role="presentation">
                <button type="button"
                        class="nav-link active"
                        id="slms-tab-components"
                        role="tab"
                        data-slms-tab="components"
                        aria-selected="true"
                        aria-controls="slms-library-grid">
                    {{#str}} tab_components, tiny_studiolms {{/str}}
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button type="button"
                        class="nav-link"
                        id="slms-tab-official"
                        role="tab"
                        data-slms-tab="global"
                        aria-selected="false"
                        aria-controls="slms-library-grid">
                    {{#str}} tab_official, tiny_studiolms {{/str}}
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button type="button"
                        class="nav-link"
                        id="slms-tab-mine"
                        role="tab"
                        data-slms-tab="mine"
                        aria-selected="false"
                        aria-controls="slms-library-grid">
                    {{#str}} tab_mine, tiny_studiolms {{/str}}
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button type="button"
                        class="nav-link"
                        id="slms-tab-favourites"
                        role="tab"
                        data-slms-tab="favourites"
                        aria-selected="false"
                        aria-controls="slms-library-grid">
                    {{#str}} tab_favourites, tiny_studiolms {{/str}}
                </button>
            </li>
        </ul>
        <div id="slms-tab-toolbar" class="d-none px-3 py-2 border-bottom">
            <button type="button" id="slms-btn-save-template" class="btn btn-sm btn-outline-primary">
                <span aria-hidden="true">💾</span> {{#str}} btn_save_template, tiny_studiolms {{/str}}
            </button>
        </div>
        <div id="slms-feedback-area" class="px-3" aria-live="polite"></div>
        <div class="slms-library-grid" id="slms-library-grid" role="tabpanel"></div>
    </div>
    <div id="slms-view-editor" class="d-none position-relative">
        <div class="slms-header d-flex justify-content-between align-items-center">
            <button id="slms-btn-back" class="btn btn-outline-secondary rounded-pill btn-sm">
                <span aria-hidden="true">&larr;</span> {{#str}} back_to_library, tiny_studiolms {{/str}}
            </button>
            <h5 class="m-0 fw-bold text-dark fs-6" id="slms-editor-title">StudioLMS</h5>

            <button id="slms-btn-insert" class="btn btn-primary px-4 shadow-sm rounded-pill btn-sm">
                <span class="slms-state-insert">
                    <span aria-hidden="true">🚀</span> {{#str}} btn_insert, tiny_studiolms {{/str}}
                </span>
                <span class="slms-state-update d-none">
                    <span aria-hidden="true">💾</span> {{#str}} btn_update, tiny_studiolms {{/str}}
                </span>
            </button>
        </div>
        <div id="slms-top-toolbar" class="slms-toolbar d-flex align-items-center gap-2 mb-3" role="toolbar"
             aria-label="{{#str}} configuration, tiny_studiolms {{/str}}">
        </div>
        <div class="slms-canvas-area position-relative">
            <div class="slms-preview-panel" role="region" aria-label="{{#str}} preview, tiny_studiolms {{/str}}">
                <div id="slms-live-preview" class="w-100 shadow-sm bg-white rounded p-4 slms-live-preview-box"></div>
            </div>

            <div class="slms-zoom-controls shadow-sm" role="group" aria-label="{{#str}} zoom_controls, tiny_studiolms {{/str}}">
                <button type="button" id="slms-zoom-out"
                        title="{{#str}} zoom_out, tiny_studiolms {{/str}}"
                        aria-label="{{#str}} zoom_out, tiny_studiolms {{/str}}">
                    <span aria-hidden="true">−</span>
                </button>
                <span id="slms-zoom-level" aria-live="polite">100%</span>
                <button type="button" id="slms-zoom-in"
                        title="{{#str}} zoom_in, tiny_studiolms {{/str}}"
                        aria-label="{{#str}} zoom_in, tiny_studiolms {{/str}}">
                    <span aria-hidden="true">+</span>
                </button>
            </div>
        </div>
        <div id="slms-popup-anchor" class="d-none" aria-hidden="true"></div>
    </div>
</div>
