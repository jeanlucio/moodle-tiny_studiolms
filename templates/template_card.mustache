{{!
    @template tiny_studiolms/template_card
    @copyright 2026 Jean Lúcio

    Card displayed in the template library tabs (Official, Mine, Favourites).
    Example context (json): {
        "id": 1,
        "name": "Weekly Lesson Layout",
        "isglobal": 0,
        "ismine": true,
        "isfavourite": false,
        "isPreset": false
    }
}}
<div class="slms-tpl-card" data-templateid="{{id}}">
    <div class="slms-tpl-insert" role="button" tabindex="0" aria-label="{{name}}">
        <div class="slms-tpl-thumb" aria-hidden="true">
            <div class="slms-tpl-thumb-content">{{{content}}}</div>
        </div>
        <div class="slms-tpl-meta">
            <div class="slms-tpl-name-row">
                <div class="slms-tpl-icon" aria-hidden="true">
                    {{#isglobal}}🏛️{{/isglobal}}
                    {{^isglobal}}📄{{/isglobal}}
                </div>
                <div class="slms-tpl-name">{{name}}</div>
                {{#isPreset}}<span class="badge bg-secondary ms-1 slms-preset-badge">{{#str}} preset_badge, tiny_studiolms {{/str}}</span>{{/isPreset}}
            </div>
        </div>
    </div>
    <div class="slms-tpl-actions">
        {{#ismine}}
        <input type="checkbox"
               class="slms-tpl-select form-check-input m-0"
               data-templateid="{{id}}"
               aria-label="{{#str}} select_for_export, tiny_studiolms {{/str}}"
               title="{{#str}} select_for_export, tiny_studiolms {{/str}}">
        {{/ismine}}
        {{^isPreset}}
        <button type="button"
                class="slms-btn-fav{{#isfavourite}} active{{/isfavourite}}"
                data-templateid="{{id}}"
                title="{{#isfavourite}}{{#str}} fav_remove_aria, tiny_studiolms {{/str}}{{/isfavourite}}{{^isfavourite}}{{#str}} fav_add_aria, tiny_studiolms {{/str}}{{/isfavourite}}"
                aria-label="{{#isfavourite}}{{#str}} fav_remove_aria, tiny_studiolms {{/str}}{{/isfavourite}}{{^isfavourite}}{{#str}} fav_add_aria, tiny_studiolms {{/str}}{{/isfavourite}}"
                aria-pressed="{{#isfavourite}}true{{/isfavourite}}{{^isfavourite}}false{{/isfavourite}}">
            <span aria-hidden="true">{{#isfavourite}}★{{/isfavourite}}{{^isfavourite}}☆{{/isfavourite}}</span>
        </button>
        {{/isPreset}}
        {{#ismine}}
        <button type="button"
                class="slms-btn-tpl-delete"
                data-templateid="{{id}}"
                title="{{#str}} btn_delete, tiny_studiolms {{/str}}"
                aria-label="{{#str}} btn_delete, tiny_studiolms {{/str}}">
            <span aria-hidden="true">🗑</span>
        </button>
        {{/ismine}}
    </div>
</div>
