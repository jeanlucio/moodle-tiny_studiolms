{{!
    @template tiny_studiolms/popup_callout_design
    @copyright 2026 Jean Lúcio <jeanlucio@gmail.com>

    Example context (json): {}
}}
<div class="mb-3 pb-3 border-bottom">
    <label for="pop_callout_icon" class="form-label small fw-bold">{{#str}} callout_icon, tiny_studiolms {{/str}}</label>
    <div class="input-group input-group-sm">
        <input type="text" class="form-control" id="pop_callout_icon" value="{{icon}}" placeholder="{{#str}} placeholder_emoji, tiny_studiolms {{/str}}">
        <button class="btn btn-outline-secondary" type="button" id="pop_callout_clear_icon" aria-label="{{#str}} remove, core {{/str}}">
            <span aria-hidden="true">❌</span>
        </button>
    </div>
    <div class="form-text small">{{#str}} hint_emoji, tiny_studiolms {{/str}}</div>
</div>
<div class="d-flex justify-content-between align-items-center mb-3">
    <label for="pop_callout_bg" class="form-label m-0 small fw-bold">{{#str}} bg_color, tiny_studiolms {{/str}}</label>
    <input type="color" class="slms-color-picker" id="pop_callout_bg" value="{{backgroundColor}}">
</div>
<div class="d-flex justify-content-between align-items-center mb-3">
    <label for="pop_callout_text" class="form-label m-0 small fw-bold">{{#str}} text_color, tiny_studiolms {{/str}}</label>
    <input type="color" class="slms-color-picker" id="pop_callout_text" value="{{textColor}}">
</div>
<div class="d-flex justify-content-between align-items-center mb-3">
    <label for="pop_callout_border" class="form-label m-0 small fw-bold">{{#str}} border_color, tiny_studiolms {{/str}}</label>
    <input type="color" class="slms-color-picker" id="pop_callout_border" value="{{borderColor}}">
</div>
<div class="slms-section-group">
    <div class="slms-section-title">{{#str}} interactivity_sounds, tiny_studiolms {{/str}}</div>
    <div class="d-flex justify-content-between align-items-center">
        <label for="pop_callout_hover" class="form-label m-0 small">{{#str}} hover_effect, tiny_studiolms {{/str}}</label>
        <select class="form-select form-select-sm slms-select-compact" id="pop_callout_hover">
            <option value="none" {{#hover_none}}selected{{/hover_none}}>{{#str}} hover_none, tiny_studiolms {{/str}}</option>
            <option value="scale" {{#hover_scale}}selected{{/hover_scale}}>{{#str}} hover_scale, tiny_studiolms {{/str}}</option>
            <option value="glow" {{#hover_glow}}selected{{/hover_glow}}>{{#str}} hover_glow, tiny_studiolms {{/str}}</option>
            <option value="lift" {{#hover_lift}}selected{{/hover_lift}}>{{#str}} hover_lift, tiny_studiolms {{/str}}</option>
        </select>
    </div>
</div>
