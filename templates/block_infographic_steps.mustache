{{!
    @template tiny_studiolms/block_infographic_steps

    Renders a numbered/icon-led process steps block inserted by the StudioLMS plugin.
    The `content` triple-stache carries the pre-built inner HTML generated by the JS renderer.

    Example context (json):
    {
        "theme": "blue",
        "content": "<div class=\"slms-steps__title\" style=\"color:#1e3a8a;\">How to enrol</div><div class=\"slms-steps__list\"><div class=\"slms-steps__item\"><div class=\"slms-steps__left\"><div class=\"slms-steps__badge\" style=\"background:#dbeafe;color:#1d4ed8;\"><span aria-hidden=\"true\">1</span></div><div class=\"slms-steps__connector\" style=\"background:#bfdbfe;\"></div></div><div class=\"slms-steps__content\" style=\"padding-bottom:1.25rem;\"><div class=\"slms-steps__step-title\" style=\"color:#1e3a8a;\">Create your account</div><div class=\"slms-steps__step-desc\" style=\"color:#3b5280;\">Register using your institutional email.</div></div></div></div>"
    }
}}
<div class="slms-block slms-infographic-steps-block slms-infographic-steps--{{theme}} slms-infographic-steps--{{layout}}">
    {{{content}}}
</div>
