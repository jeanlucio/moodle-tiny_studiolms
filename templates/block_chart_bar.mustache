{{!
    @template tiny_studiolms/block_chart_bar

    Renders the horizontal or vertical bar chart block inserted by the StudioLMS plugin. Plain HTML with a class
    per colour and a width (horizontal) or a height (vertical) in percent, so it survives the HTML cleaner of the
    forum, the glossary, the questions and the assignments.

    Example context (json):
    {
        "type": "horizontal",
        "horizontal": true,
        "title": "Desempenho da Turma",
        "items": [
            {"label": "Aprovados", "pct": 75, "shown": "75%", "size": 100, "color": 1},
            {"label": "Em progresso", "pct": 15, "shown": "15%", "size": 20, "color": 2}
        ]
    }
}}
<div class="slms-block slms-chart-bar-block slms-chart-bar--{{type}} slms-align-{{align}}{{#hoverEffect}} slms-hov-{{hoverEffect}}{{/hoverEffect}}">
    {{#title}}<div class="slms-chart-bar__title">{{title}}</div>{{/title}}
    {{#horizontal}}
    {{#items}}
    <div class="slms-bar-row">
        <div class="slms-bar-row__label">{{label}}</div>
        <div class="slms-bar-row__track">
            <div class="slms-bar-row__fill slms-bar-c{{color}}" style="width: {{size}}%"></div>
        </div>
        <div class="slms-bar-row__pct">{{shown}}</div>
    </div>
    {{/items}}
    {{/horizontal}}
    {{^horizontal}}
    <div class="slms-bar-cols">
        {{#items}}
        <div class="slms-bar-col">
            <div class="slms-bar-col__pct">{{shown}}</div>
            <div class="slms-bar-col__plot">
                <div class="slms-bar-col__fill slms-bar-c{{color}}" style="height: {{size}}%"></div>
            </div>
            <div class="slms-bar-col__label">{{label}}</div>
        </div>
        {{/items}}
    </div>
    {{/horizontal}}
</div>
