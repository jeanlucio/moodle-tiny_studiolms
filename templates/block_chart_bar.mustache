{{!
    @template tiny_studiolms/block_chart_bar

    Renders a horizontal or vertical bar chart block inserted by the StudioLMS plugin.
    The `svg` triple-stache carries pre-built SVG markup generated by chart_bar.js.

    Example context (json):
    {
        "type": "horizontal",
        "title": "Desempenho da Turma",
        "svg": "<svg viewBox=\"0 0 340 114\" role=\"img\" xmlns=\"http://www.w3.org/2000/svg\" class=\"slms-chart-bar__svg\"></svg>"
    }
}}
<div class="slms-block slms-chart-bar-block slms-chart-bar--{{type}}{{#hoverEffect}} slms-hov-{{hoverEffect}}{{/hoverEffect}}">
    {{#title}}<div class="slms-chart-bar__title">{{title}}</div>{{/title}}
    <div class="slms-chart-bar__wrap">
        {{{svg}}}
    </div>
</div>
