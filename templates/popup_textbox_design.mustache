{{!
    @template tiny_studiolms/popup_textbox_design
    @copyright 2026 Jean Lúcio

    Example context (json): {"alignLeft": true, "alignCenter": false, "alignRight": false, "alignJustify": false}
}}
<div class="mb-3">
    <label for="pop_textbox_align" class="form-label small fw-bold">{{#str}} alignment, tiny_studiolms {{/str}}</label>
    <select class="form-select form-select-sm" id="pop_textbox_align">
        <option value="left" {{#alignLeft}}selected{{/alignLeft}}>{{#str}} align_left, tiny_studiolms {{/str}}</option>
        <option value="center" {{#alignCenter}}selected{{/alignCenter}}>{{#str}} align_center, tiny_studiolms {{/str}}</option>
        <option value="right" {{#alignRight}}selected{{/alignRight}}>{{#str}} align_right, tiny_studiolms {{/str}}</option>
        <option value="justify" {{#alignJustify}}selected{{/alignJustify}}>{{#str}} align_justify, tiny_studiolms {{/str}}</option>
    </select>
</div>
