{{!
    @template tiny_studiolms/popup_profilecard_content
    @copyright 2026 Jean Lúcio <jeanlucio@gmail.com>

    Example context (json): {
        "photoUrl": "", "name": "", "role": "", "bio": "",
        "link0label": "", "link0url": "", "link1label": "", "link1url": "",
        "link2label": "", "link2url": "", "bgColor": "#ffffff", "accentColor": "#0f6cbf"
    }
}}
<div class="mb-3">
    <label for="pop_pc_photo" class="form-label small fw-bold text-muted">
        {{#str}} profilecard_photo_url, tiny_studiolms {{/str}}
    </label>
    <input type="url" class="form-control form-control-sm" id="pop_pc_photo"
           value="{{photoUrl}}" placeholder="https://...">
</div>

<div class="mb-3">
    <label for="pop_pc_name" class="form-label small fw-bold text-muted">
        {{#str}} profilecard_name, tiny_studiolms {{/str}}
    </label>
    <input type="text" class="form-control form-control-sm" id="pop_pc_name" value="{{name}}">
</div>

<div class="mb-3">
    <label for="pop_pc_role" class="form-label small fw-bold text-muted">
        {{#str}} profilecard_role, tiny_studiolms {{/str}}
    </label>
    <input type="text" class="form-control form-control-sm" id="pop_pc_role" value="{{role}}">
</div>

<div class="mb-3">
    <label for="pop_pc_bio" class="form-label small fw-bold text-muted">
        {{#str}} profilecard_bio, tiny_studiolms {{/str}}
    </label>
    <textarea class="form-control form-control-sm" id="pop_pc_bio" rows="2">{{bio}}</textarea>
</div>

<div class="mb-3 pt-2 border-top">
    <div class="small fw-bold text-muted mb-2">{{#str}} profilecard_links, tiny_studiolms {{/str}}</div>

    <div class="d-flex align-items-center mb-2">
        <input type="text" class="form-control form-control-sm me-1" id="pop_pc_link0label"
               value="{{link0label}}" placeholder="{{#str}} profilecard_link_label, tiny_studiolms {{/str}}"
               style="max-width: 90px;">
        <input type="url" class="form-control form-control-sm" id="pop_pc_link0url"
               value="{{link0url}}" placeholder="https://...">
    </div>

    <div class="d-flex align-items-center mb-2">
        <input type="text" class="form-control form-control-sm me-1" id="pop_pc_link1label"
               value="{{link1label}}" placeholder="{{#str}} profilecard_link_label, tiny_studiolms {{/str}}"
               style="max-width: 90px;">
        <input type="url" class="form-control form-control-sm" id="pop_pc_link1url"
               value="{{link1url}}" placeholder="https://...">
    </div>

    <div class="d-flex align-items-center mb-2">
        <input type="text" class="form-control form-control-sm me-1" id="pop_pc_link2label"
               value="{{link2label}}" placeholder="{{#str}} profilecard_link_label, tiny_studiolms {{/str}}"
               style="max-width: 90px;">
        <input type="url" class="form-control form-control-sm" id="pop_pc_link2url"
               value="{{link2url}}" placeholder="https://...">
    </div>
</div>

<div class="d-flex justify-content-between align-items-center pt-2 border-top mb-2">
    <label for="pop_pc_bg" class="form-label m-0 small fw-bold text-muted">
        {{#str}} profilecard_bg_color, tiny_studiolms {{/str}}
    </label>
    <input type="color" class="slms-color-picker" id="pop_pc_bg" value="{{bgColor}}">
</div>

<div class="d-flex justify-content-between align-items-center">
    <label for="pop_pc_accent" class="form-label m-0 small fw-bold text-muted">
        {{#str}} profilecard_accent_color, tiny_studiolms {{/str}}
    </label>
    <input type="color" class="slms-color-picker" id="pop_pc_accent" value="{{accentColor}}">
</div>
