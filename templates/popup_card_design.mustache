{{!
    @template tiny_studiolms/popup_card_design
    @copyright 2026 Jean Lúcio <jeanlucio@gmail.com>

    Example context (json): {
        "bg": "#ffffff", "text": "#212529", "border": "#0d47a1", "radius": 8
    }
}}
<div class="d-flex justify-content-between align-items-center mb-3">
    <label for="pop_card_bg" class="form-label m-0 small fw-bold">{{#str}} bg_color, tiny_studiolms {{/str}}</label>
    <input type="color" class="slms-color-picker" id="pop_card_bg" value="{{bg}}">
</div>
<div class="d-flex justify-content-between align-items-center mb-3">
    <label for="pop_card_text" class="form-label m-0 small fw-bold">{{#str}} text_color, tiny_studiolms {{/str}}</label>
    <input type="color" class="slms-color-picker" id="pop_card_text" value="{{text}}">
</div>
<div class="d-flex justify-content-between align-items-center mb-3">
    <label for="pop_card_border" class="form-label m-0 small fw-bold">{{#str}} border_color, tiny_studiolms {{/str}}</label>
    <input type="color" class="slms-color-picker" id="pop_card_border" value="{{border}}">
</div>
<div class="d-flex justify-content-between align-items-center mb-3">
    <label for="pop_card_radius" class="form-label m-0 small fw-bold">{{#str}} border_radius, tiny_studiolms {{/str}}</label>
    <input type="number" class="form-control form-control-sm slms-input-number" id="pop_card_radius" value="{{radius}}" min="0" max="50">
</div>
<div class="mb-1">
    <label for="pop_card_shadow" class="form-label small fw-bold">{{#str}} shadow, tiny_studiolms {{/str}}</label>
    <select class="form-select form-select-sm" id="pop_card_shadow">
        <option value="none" {{#shadow_none}}selected{{/shadow_none}}>{{#str}} shadow_none, tiny_studiolms {{/str}}</option>
        <option value="sm" {{#shadow_sm}}selected{{/shadow_sm}}>{{#str}} shadow_sm, tiny_studiolms {{/str}}</option>
        <option value="md" {{#shadow_md}}selected{{/shadow_md}}>{{#str}} shadow_md, tiny_studiolms {{/str}}</option>
        <option value="lg" {{#shadow_lg}}selected{{/shadow_lg}}>{{#str}} shadow_lg, tiny_studiolms {{/str}}</option>
    </select>
</div>
<div class="slms-section-group">
    <div class="slms-section-title">{{#str}} interactivity_sounds, tiny_studiolms {{/str}}</div>
    <div class="d-flex justify-content-between align-items-center">
        <label for="pop_card_hover" class="form-label m-0 small">{{#str}} hover_effect, tiny_studiolms {{/str}}</label>
        <select class="form-select form-select-sm slms-select-compact" id="pop_card_hover">
            <option value="none" {{#hover_none}}selected{{/hover_none}}>{{#str}} hover_none, tiny_studiolms {{/str}}</option>
            <option value="scale" {{#hover_scale}}selected{{/hover_scale}}>{{#str}} hover_scale, tiny_studiolms {{/str}}</option>
            <option value="glow" {{#hover_glow}}selected{{/hover_glow}}>{{#str}} hover_glow, tiny_studiolms {{/str}}</option>
            <option value="lift" {{#hover_lift}}selected{{/hover_lift}}>{{#str}} hover_lift, tiny_studiolms {{/str}}</option>
        </select>
    </div>
</div>

<hr class="my-2"/>

<div>
    <span class="form-label small fw-semibold d-block mb-2">
        ✨ {{#str}}card_ai_section, tiny_studiolms{{/str}}
    </span>
    <textarea id="card_ai_prompt"
              class="form-control form-control-sm"
              rows="2"
              placeholder="{{#str}}card_ai_prompt, tiny_studiolms{{/str}}"></textarea>
    <div class="d-flex align-items-center mt-2" style="gap:8px;">
        <button type="button" class="btn btn-sm btn-primary" id="card-ai-btn">
            {{#str}}card_ai_generate, tiny_studiolms{{/str}}
        </button>
        <div id="card-ai-spinner"
             class="spinner-border spinner-border-sm text-primary d-none"
             role="status"
             aria-hidden="true"></div>
    </div>
    <div id="card-ai-error" class="text-danger small mt-1 d-none"></div>
</div>
