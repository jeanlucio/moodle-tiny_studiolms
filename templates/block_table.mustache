{{!
    @template tiny_studiolms/block_table
    @copyright 2026 Jean Lúcio <jeanlucio@gmail.com>

    Example context (json): {
        "isStriped": true,
        "headerCells": [{"headerBg": "#0f172a", "headerText": "#ffffff", "content": "Header"}],
        "bodyRows": [{"cells": [{"content": "Data"}]}]
    }
}}
<div class="studiolms-table-wrap mb-4 w-100">
    <table class="table studiolms-table {{#isStriped}}table-striped{{/isStriped}}{{^isStriped}}table-bordered{{/isStriped}} bg-white m-0">
        <thead>
            <tr>
                {{#headerCells}}
                <th scope="col" style="background-color: {{headerBg}}; color: {{headerText}};">
                    {{{content}}}
                </th>
                {{/headerCells}}
            </tr>
        </thead>
        <tbody>
            {{#bodyRows}}
            <tr>
                {{#cells}}
                <td class="p-3 border align-middle">
                    {{{content}}}
                </td>
                {{/cells}}
            </tr>
            {{/bodyRows}}
        </tbody>
    </table>
</div>
<p><br></p>
