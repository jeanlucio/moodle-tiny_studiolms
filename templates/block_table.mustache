{{!
    @template tiny_studiolms/block_table
    @copyright 2026 Jean Lúcio <jeanlucio@gmail.com>

    Example context (json): {
        "isStriped": true,
        "headerCells": [{"headerBg": "#0f172a", "headerText": "#ffffff", "content": "Header"}],
        "bodyRows": [{"cells": [{"content": "Data"}]}]
    }
}}
<div class="studiolms-table-wrap" style="margin-bottom: 1.5rem; width: 100%;">
    <table class="table {{#isStriped}}table-striped{{/isStriped}} {{^isStriped}}table-bordered{{/isStriped}}"
           style="width: 100%; border-collapse: collapse; margin-bottom: 0; background-color: #ffffff;">
        <thead>
            <tr>
                {{#headerCells}}
                <th style="background-color: {{headerBg}}; color: {{headerText}}; padding: 12px; border: 1px solid rgba(0,0,0,0.1); font-weight: 600; text-align: left; vertical-align: middle;">
                    {{{content}}}
                </th>
                {{/headerCells}}
            </tr>
        </thead>
        <tbody>
            {{#bodyRows}}
            <tr>
                {{#cells}}
                <td style="padding: 12px; border: 1px solid rgba(0,0,0,0.1); vertical-align: middle;">
                    {{{content}}}
                </td>
                {{/cells}}
            </tr>
            {{/bodyRows}}
        </tbody>
    </table>
</div>
<p><br></p>
