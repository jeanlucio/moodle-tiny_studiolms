{{!
    @template tiny_studiolms/block_accordion
    @copyright 2026 Jean Lúcio <jeanlucio@gmail.com>

    Example context (json): {
        "state": "open", "bg": "#ffffff", "color": "#3b82f6", "title": "Topic",
        "iconFirst": "▶", "content": "<p>Content</p>"
    }
}}
<div class="studiolms-accordion-wrap mb-4 w-100">
    <details class="studiolms-accordion" data-initial-state="{{state}}" open style="--slms-bg: {{bg}};">
        <summary class="studiolms-accordion-summary">
            <span class="studiolms-accordion-header" style="--slms-color: {{color}};">
                <span class="slms-acc-title flex-grow-1" contenteditable="true">{{title}}</span>
                <span contenteditable="false" aria-hidden="true" class="ms-3 user-select-none">{{iconFirst}}</span>
            </span>
        </summary>
        <div class="studiolms-editable-area studiolms-accordion-content" contenteditable="true">
            {{{content}}}
        </div>
    </details>
</div>
<p><br></p>
