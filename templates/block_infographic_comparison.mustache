{{!
    @template tiny_studiolms/block_infographic_comparison

    Rendered output for the StudioLMS infographic comparison block.
    The `content` variable contains pre-built HTML from the JS renderer.

    Example context (json):
    {
        "theme": "blue",
        "content": "<div class=\"slms-comparison__table\"></div>"
    }
}}
<div class="slms-block slms-infographic-comparison-block slms-infographic-comparison--{{theme}} slms-align-{{align}} slms-width-{{width}}{{#hoverEffect}} slms-hov-{{hoverEffect}}{{/hoverEffect}}">
    {{{content}}}
</div>
