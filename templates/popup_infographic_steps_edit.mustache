{{!
    @template tiny_studiolms/popup_infographic_steps_edit

    Edit popup for the StudioLMS infographic steps block.
    Each item row has an optional visual icon-picker button (falls back to step number),
    a title input and a description input. Up to 6 steps; blank rows are ignored on render.

    Example context (json):
    {
        "title": "How to get started",
        "item1_icon": "",
        "item1_title": "Create your account",
        "item1_description": "Register on the platform using your institutional email.",
        "item1_stepnum": 1,
        "item1_hasicon": false,
        "item2_icon": "fa-solid fa-book-open",
        "item2_title": "Enrol in a course",
        "item2_description": "Browse the catalogue and click Enrol.",
        "item2_stepnum": 2,
        "item2_hasicon": true,
        "item3_icon": "",
        "item3_title": "Complete the activities",
        "item3_description": "",
        "item3_stepnum": 3,
        "item3_hasicon": false,
        "item4_icon": "",
        "item4_title": "",
        "item4_description": "",
        "item4_stepnum": 4,
        "item4_hasicon": false,
        "item5_icon": "",
        "item5_title": "",
        "item5_description": "",
        "item5_stepnum": 5,
        "item5_hasicon": false,
        "item6_icon": "",
        "item6_title": "",
        "item6_description": "",
        "item6_stepnum": 6,
        "item6_hasicon": false,
        "themeBlue": true,
        "themeGreen": false,
        "themePurple": false,
        "themeOrange": false
    }
}}
<div class="slms-popup-infographic-steps-edit">

    {{! Optional title }}
    <div class="mb-2">
        <label for="st_title" class="form-label small fw-semibold">
            {{#str}}infographic_steps_title, tiny_studiolms{{/str}}
        </label>
        <input type="text"
               id="st_title"
               class="form-control form-control-sm"
               value="{{title}}"
               maxlength="80"/>
    </div>

    {{! Step rows: [icon-btn] [title] / [description] }}
    <div class="mb-2">
        <span class="form-label small fw-semibold d-block mb-1">
            {{#str}}infographic_steps_items, tiny_studiolms{{/str}}
        </span>

        {{! Step 1 }}
        <div class="slms-st-item-row">
            <button type="button"
                    class="slms-st-icon-btn"
                    data-item="1"
                    aria-label="{{#str}}infographic_choose_icon, tiny_studiolms{{/str}}"
                    title="{{#str}}infographic_choose_icon, tiny_studiolms{{/str}}">
                {{#item1_hasicon}}<i class="{{item1_icon}}" aria-hidden="true"></i>{{/item1_hasicon}}
                {{^item1_hasicon}}<span aria-hidden="true">{{item1_stepnum}}</span>{{/item1_hasicon}}
            </button>
            <input type="hidden" id="st_item1_icon" value="{{item1_icon}}"/>
            <div class="slms-st-item-fields">
                <input type="text"
                       id="st_item1_title"
                       class="form-control form-control-sm"
                       value="{{item1_title}}"
                       placeholder="{{#str}}infographic_steps_item_title_ph, tiny_studiolms{{/str}}"
                       aria-label="{{#str}}infographic_steps_item_title, tiny_studiolms{{/str}} 1"/>
                <input type="text"
                       id="st_item1_description"
                       class="form-control form-control-sm slms-st-desc-input"
                       value="{{item1_description}}"
                       placeholder="{{#str}}infographic_steps_item_description_ph, tiny_studiolms{{/str}}"
                       aria-label="{{#str}}infographic_steps_item_description, tiny_studiolms{{/str}} 1"/>
            </div>
        </div>

        {{! Step 2 }}
        <div class="slms-st-item-row">
            <button type="button"
                    class="slms-st-icon-btn"
                    data-item="2"
                    aria-label="{{#str}}infographic_choose_icon, tiny_studiolms{{/str}}"
                    title="{{#str}}infographic_choose_icon, tiny_studiolms{{/str}}">
                {{#item2_hasicon}}<i class="{{item2_icon}}" aria-hidden="true"></i>{{/item2_hasicon}}
                {{^item2_hasicon}}<span aria-hidden="true">{{item2_stepnum}}</span>{{/item2_hasicon}}
            </button>
            <input type="hidden" id="st_item2_icon" value="{{item2_icon}}"/>
            <div class="slms-st-item-fields">
                <input type="text"
                       id="st_item2_title"
                       class="form-control form-control-sm"
                       value="{{item2_title}}"
                       placeholder="{{#str}}infographic_steps_item_title_ph, tiny_studiolms{{/str}}"
                       aria-label="{{#str}}infographic_steps_item_title, tiny_studiolms{{/str}} 2"/>
                <input type="text"
                       id="st_item2_description"
                       class="form-control form-control-sm slms-st-desc-input"
                       value="{{item2_description}}"
                       placeholder="{{#str}}infographic_steps_item_description_ph, tiny_studiolms{{/str}}"
                       aria-label="{{#str}}infographic_steps_item_description, tiny_studiolms{{/str}} 2"/>
            </div>
        </div>

        {{! Step 3 }}
        <div class="slms-st-item-row">
            <button type="button"
                    class="slms-st-icon-btn"
                    data-item="3"
                    aria-label="{{#str}}infographic_choose_icon, tiny_studiolms{{/str}}"
                    title="{{#str}}infographic_choose_icon, tiny_studiolms{{/str}}">
                {{#item3_hasicon}}<i class="{{item3_icon}}" aria-hidden="true"></i>{{/item3_hasicon}}
                {{^item3_hasicon}}<span aria-hidden="true">{{item3_stepnum}}</span>{{/item3_hasicon}}
            </button>
            <input type="hidden" id="st_item3_icon" value="{{item3_icon}}"/>
            <div class="slms-st-item-fields">
                <input type="text"
                       id="st_item3_title"
                       class="form-control form-control-sm"
                       value="{{item3_title}}"
                       placeholder="{{#str}}infographic_steps_item_title_ph, tiny_studiolms{{/str}}"
                       aria-label="{{#str}}infographic_steps_item_title, tiny_studiolms{{/str}} 3"/>
                <input type="text"
                       id="st_item3_description"
                       class="form-control form-control-sm slms-st-desc-input"
                       value="{{item3_description}}"
                       placeholder="{{#str}}infographic_steps_item_description_ph, tiny_studiolms{{/str}}"
                       aria-label="{{#str}}infographic_steps_item_description, tiny_studiolms{{/str}} 3"/>
            </div>
        </div>

        {{! Step 4 }}
        <div class="slms-st-item-row">
            <button type="button"
                    class="slms-st-icon-btn"
                    data-item="4"
                    aria-label="{{#str}}infographic_choose_icon, tiny_studiolms{{/str}}"
                    title="{{#str}}infographic_choose_icon, tiny_studiolms{{/str}}">
                {{#item4_hasicon}}<i class="{{item4_icon}}" aria-hidden="true"></i>{{/item4_hasicon}}
                {{^item4_hasicon}}<span aria-hidden="true">{{item4_stepnum}}</span>{{/item4_hasicon}}
            </button>
            <input type="hidden" id="st_item4_icon" value="{{item4_icon}}"/>
            <div class="slms-st-item-fields">
                <input type="text"
                       id="st_item4_title"
                       class="form-control form-control-sm"
                       value="{{item4_title}}"
                       placeholder="{{#str}}infographic_steps_item_title_ph, tiny_studiolms{{/str}}"
                       aria-label="{{#str}}infographic_steps_item_title, tiny_studiolms{{/str}} 4"/>
                <input type="text"
                       id="st_item4_description"
                       class="form-control form-control-sm slms-st-desc-input"
                       value="{{item4_description}}"
                       placeholder="{{#str}}infographic_steps_item_description_ph, tiny_studiolms{{/str}}"
                       aria-label="{{#str}}infographic_steps_item_description, tiny_studiolms{{/str}} 4"/>
            </div>
        </div>

        {{! Step 5 }}
        <div class="slms-st-item-row">
            <button type="button"
                    class="slms-st-icon-btn"
                    data-item="5"
                    aria-label="{{#str}}infographic_choose_icon, tiny_studiolms{{/str}}"
                    title="{{#str}}infographic_choose_icon, tiny_studiolms{{/str}}">
                {{#item5_hasicon}}<i class="{{item5_icon}}" aria-hidden="true"></i>{{/item5_hasicon}}
                {{^item5_hasicon}}<span aria-hidden="true">{{item5_stepnum}}</span>{{/item5_hasicon}}
            </button>
            <input type="hidden" id="st_item5_icon" value="{{item5_icon}}"/>
            <div class="slms-st-item-fields">
                <input type="text"
                       id="st_item5_title"
                       class="form-control form-control-sm"
                       value="{{item5_title}}"
                       placeholder="{{#str}}infographic_steps_item_title_ph, tiny_studiolms{{/str}}"
                       aria-label="{{#str}}infographic_steps_item_title, tiny_studiolms{{/str}} 5"/>
                <input type="text"
                       id="st_item5_description"
                       class="form-control form-control-sm slms-st-desc-input"
                       value="{{item5_description}}"
                       placeholder="{{#str}}infographic_steps_item_description_ph, tiny_studiolms{{/str}}"
                       aria-label="{{#str}}infographic_steps_item_description, tiny_studiolms{{/str}} 5"/>
            </div>
        </div>

        {{! Step 6 — optional }}
        <div class="slms-st-item-row">
            <button type="button"
                    class="slms-st-icon-btn"
                    data-item="6"
                    aria-label="{{#str}}infographic_choose_icon, tiny_studiolms{{/str}}"
                    title="{{#str}}infographic_choose_icon, tiny_studiolms{{/str}}">
                {{#item6_hasicon}}<i class="{{item6_icon}}" aria-hidden="true"></i>{{/item6_hasicon}}
                {{^item6_hasicon}}<span aria-hidden="true">{{item6_stepnum}}</span>{{/item6_hasicon}}
            </button>
            <input type="hidden" id="st_item6_icon" value="{{item6_icon}}"/>
            <div class="slms-st-item-fields">
                <input type="text"
                       id="st_item6_title"
                       class="form-control form-control-sm"
                       value="{{item6_title}}"
                       placeholder="{{#str}}infographic_steps_item_title_ph, tiny_studiolms{{/str}}"
                       aria-label="{{#str}}infographic_steps_item_title, tiny_studiolms{{/str}} 6"/>
                <input type="text"
                       id="st_item6_description"
                       class="form-control form-control-sm slms-st-desc-input"
                       value="{{item6_description}}"
                       placeholder="{{#str}}infographic_steps_item_description_ph, tiny_studiolms{{/str}}"
                       aria-label="{{#str}}infographic_steps_item_description, tiny_studiolms{{/str}} 6"/>
            </div>
        </div>
    </div>

    {{! Theme picker }}
    <div class="mb-2">
        <span class="form-label small fw-semibold d-block mb-1">
            {{#str}}infographic_theme, tiny_studiolms{{/str}}
        </span>
        <div class="d-flex align-items-center" style="gap:8px;">
            <button type="button"
                    class="slms-ig-theme-btn{{#themeBlue}} selected{{/themeBlue}}"
                    data-theme="blue"
                    aria-label="{{#str}}infographic_theme_blue, tiny_studiolms{{/str}}"
                    style="background:#1d4ed8;">
            </button>
            <button type="button"
                    class="slms-ig-theme-btn{{#themeGreen}} selected{{/themeGreen}}"
                    data-theme="green"
                    aria-label="{{#str}}infographic_theme_green, tiny_studiolms{{/str}}"
                    style="background:#15803d;">
            </button>
            <button type="button"
                    class="slms-ig-theme-btn{{#themePurple}} selected{{/themePurple}}"
                    data-theme="purple"
                    aria-label="{{#str}}infographic_theme_purple, tiny_studiolms{{/str}}"
                    style="background:#7c3aed;">
            </button>
            <button type="button"
                    class="slms-ig-theme-btn{{#themeOrange}} selected{{/themeOrange}}"
                    data-theme="orange"
                    aria-label="{{#str}}infographic_theme_orange, tiny_studiolms{{/str}}"
                    style="background:#c2410c;">
            </button>
            <button type="button"
                    class="slms-ig-theme-btn{{#themeRed}} selected{{/themeRed}}"
                    data-theme="red"
                    aria-label="{{#str}}infographic_theme_red, tiny_studiolms{{/str}}"
                    style="background:#be123c;">
            </button>
            <button type="button"
                    class="slms-ig-theme-btn{{#themeBlack}} selected{{/themeBlack}}"
                    data-theme="black"
                    aria-label="{{#str}}infographic_theme_black, tiny_studiolms{{/str}}"
                    style="background:#0f172a;">
            </button>
        </div>
    </div>

    {{! Layout picker }}
    <div class="mb-2">
        <span class="form-label small fw-semibold d-block mb-1">
            {{#str}}infographic_steps_layout, tiny_studiolms{{/str}}
        </span>
        <div class="d-flex align-items-center" style="gap:6px;">
            <button type="button"
                    class="slms-st-layout-btn{{#layoutVertical}} selected{{/layoutVertical}}"
                    data-layout="vertical"
                    aria-label="{{#str}}infographic_steps_layout_vertical, tiny_studiolms{{/str}}">
                <i class="fa-solid fa-bars" aria-hidden="true"></i>
                {{#str}}infographic_steps_layout_vertical, tiny_studiolms{{/str}}
            </button>
            <button type="button"
                    class="slms-st-layout-btn{{#layoutHorizontal}} selected{{/layoutHorizontal}}"
                    data-layout="horizontal"
                    aria-label="{{#str}}infographic_steps_layout_horizontal, tiny_studiolms{{/str}}">
                <i class="fa-solid fa-ellipsis" aria-hidden="true"></i>
                {{#str}}infographic_steps_layout_horizontal, tiny_studiolms{{/str}}
            </button>
        </div>
    </div>

    <hr class="my-2"/>

    {{! AI generation }}
    <div>
        <span class="form-label small fw-semibold d-block mb-1">
            ✨ {{#str}}infographic_ai_section, tiny_studiolms{{/str}}
        </span>
        <textarea id="st_ai_prompt"
                  class="form-control form-control-sm"
                  rows="2"
                  placeholder="{{#str}}infographic_steps_ai_prompt, tiny_studiolms{{/str}}"></textarea>
        <div class="d-flex align-items-center mt-2" style="gap:8px;">
            <button type="button" class="btn btn-sm btn-primary" id="st-ai-btn">
                {{#str}}infographic_ai_generate, tiny_studiolms{{/str}}
            </button>
            <div id="st-ai-spinner"
                 class="spinner-border spinner-border-sm text-primary d-none"
                 role="status"
                 aria-hidden="true"></div>
        </div>
        <div id="st-ai-error" class="text-danger small mt-1 d-none"></div>
    </div>

</div>
