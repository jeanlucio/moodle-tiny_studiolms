{{!
    @template tiny_studiolms/popup_mindmap_edit

    Edit popup for the StudioLMS mind map block.
    Allows manual editing of topic and branches, plus AI generation.

    Example context (json):
    {
        "topic": "Fotossíntese",
        "branches_text": "Reagentes: CO2, H2O, Luz\nProdutos: Glicose, Oxigênio\nLocal: Cloroplasto, Folhas",
        "theme_blue": true,
        "theme_green": false,
        "theme_purple": false,
        "theme_orange": false
    }
}}
<div class="slms-popup-mindmap-edit p-3">

    <div class="mb-3">
        <label for="mm_topic" class="form-label small fw-semibold">
            {{#str}}mindmap_topic, tiny_studiolms{{/str}}
        </label>
        <input type="text"
               id="mm_topic"
               class="form-control form-control-sm"
               value="{{topic}}"
               maxlength="50"/>
    </div>

    <div class="mb-3">
        <label for="mm_branches" class="form-label small fw-semibold">
            {{#str}}mindmap_branches, tiny_studiolms{{/str}}
        </label>
        <textarea id="mm_branches"
                  class="form-control form-control-sm slms-mm-branches-area"
                  rows="5">{{branches_text}}</textarea>
        <div class="form-text mt-1" style="font-size:11px;line-height:1.3;">
            {{#str}}mindmap_branches_help, tiny_studiolms{{/str}}
        </div>
    </div>

    <div class="mb-3">
        <span class="form-label small fw-semibold d-block mb-2">
            {{#str}}mindmap_theme, tiny_studiolms{{/str}}
        </span>
        <div class="d-flex align-items-center" style="gap:10px;">
            <button type="button"
                    class="slms-mm-theme-btn{{#theme_blue}} selected{{/theme_blue}}"
                    data-theme="blue"
                    aria-label="{{#str}}mindmap_theme_blue, tiny_studiolms{{/str}}"
                    style="background:#1e3a8a;">
            </button>
            <button type="button"
                    class="slms-mm-theme-btn{{#theme_green}} selected{{/theme_green}}"
                    data-theme="green"
                    aria-label="{{#str}}mindmap_theme_green, tiny_studiolms{{/str}}"
                    style="background:#14532d;">
            </button>
            <button type="button"
                    class="slms-mm-theme-btn{{#theme_purple}} selected{{/theme_purple}}"
                    data-theme="purple"
                    aria-label="{{#str}}mindmap_theme_purple, tiny_studiolms{{/str}}"
                    style="background:#581c87;">
            </button>
            <button type="button"
                    class="slms-mm-theme-btn{{#theme_orange}} selected{{/theme_orange}}"
                    data-theme="orange"
                    aria-label="{{#str}}mindmap_theme_orange, tiny_studiolms{{/str}}"
                    style="background:#c2410c;">
            </button>
        </div>
    </div>

    <hr class="my-2"/>

    <div>
        <span class="form-label small fw-semibold d-block mb-2">
            ✨ {{#str}}mindmap_ai_section, tiny_studiolms{{/str}}
        </span>
        <textarea id="mm_ai_prompt"
                  class="form-control form-control-sm"
                  rows="2"
                  placeholder="{{#str}}mindmap_ai_prompt, tiny_studiolms{{/str}}"></textarea>
        <div class="d-flex align-items-center mt-2" style="gap:8px;">
            <button type="button" class="btn btn-sm btn-primary" id="mm-ai-btn">
                {{#str}}mindmap_ai_generate, tiny_studiolms{{/str}}
            </button>
            <div id="mm-ai-spinner"
                 class="spinner-border spinner-border-sm text-primary d-none"
                 role="status"
                 aria-hidden="true"></div>
        </div>
        <div id="mm-ai-error" class="text-danger small mt-1 d-none"></div>
    </div>

</div>
