{{!
    @template tiny_studiolms/popup_accordion_design
    @copyright 2026 Jean Lúcio

    Example context (json): {"headerBgValue": "#ffffff", "bg": "#ffffff", "isClosed": true, "blockColorValue": "#ffffff", "animate": true, "contentColorValue": "#212529"}
}}
<div class="mb-3">
    <label for="pop_acc_icon" class="form-label small fw-bold">{{#str}} icon_pair, tiny_studiolms {{/str}}</label>
    <select class="form-select form-select-sm" id="pop_acc_icon">
        <option value="❯ / ❯" {{#icon_chevron}}selected{{/icon_chevron}}>{{#str}} icon_chevron, tiny_studiolms {{/str}}</option>
        <option value="▶ / ▼" {{#icon_triangle}}selected{{/icon_triangle}}>{{#str}} icon_triangles, tiny_studiolms {{/str}}</option>
        <option value="➕ / ➖" {{#icon_plus}}selected{{/icon_plus}}>{{#str}} icon_plus_minus, tiny_studiolms {{/str}}</option>
        <option value="📁 / 📂" {{#icon_folder}}selected{{/icon_folder}}>{{#str}} icon_folders, tiny_studiolms {{/str}}</option>
    </select>
</div>
<div class="d-flex justify-content-between align-items-center mb-2">
    <label for="pop_acc_block_color" class="form-label m-0 small fw-bold">{{#str}} accordion_block_color, tiny_studiolms {{/str}}</label>
    <input type="color" class="slms-color-picker" id="pop_acc_block_color" value="{{blockColorValue}}">
</div>
<div class="form-text small mb-3">{{#str}} accordion_colors_fine_tune, tiny_studiolms {{/str}}</div>
<div class="d-flex justify-content-between align-items-center mb-3">
    <label for="pop_acc_color" class="form-label m-0 small fw-bold">{{#str}} accordion_title_color, tiny_studiolms {{/str}}</label>
    <input type="color" class="slms-color-picker" id="pop_acc_color" value="{{color}}">
</div>
<div class="d-flex justify-content-between align-items-center mb-3">
    <label for="pop_acc_header_bg" class="form-label m-0 small fw-bold">{{#str}} accordion_header_bg, tiny_studiolms {{/str}}</label>
    <input type="color" class="slms-color-picker" id="pop_acc_header_bg" value="{{headerBgValue}}">
</div>
<div class="d-flex justify-content-between align-items-center mb-3">
    <label for="pop_acc_content_color" class="form-label m-0 small fw-bold">{{#str}} accordion_content_color, tiny_studiolms {{/str}}</label>
    <input type="color" class="slms-color-picker" id="pop_acc_content_color" value="{{contentColorValue}}">
</div>
<div class="d-flex justify-content-between align-items-center">
    <label for="pop_acc_bg" class="form-label m-0 small fw-bold">{{#str}} accordion_content_bg, tiny_studiolms {{/str}}</label>
    <input type="color" class="slms-color-picker" id="pop_acc_bg" value="{{bg}}">
</div>
<div class="mt-3">
    <label for="pop_acc_state" class="form-label small fw-bold">{{#str}} initial_state, tiny_studiolms {{/str}}</label>
    <select class="form-select form-select-sm" id="pop_acc_state">
        <option value="closed" {{#isClosed}}selected{{/isClosed}}>{{#str}} state_closed, tiny_studiolms {{/str}}</option>
        <option value="open" {{#isOpen}}selected{{/isOpen}}>{{#str}} state_open, tiny_studiolms {{/str}}</option>
    </select>
</div>
<div class="form-check mt-3">
    <input type="checkbox" class="form-check-input" id="pop_acc_animate" {{#animate}}checked{{/animate}}>
    <label for="pop_acc_animate" class="form-check-label small fw-bold">{{#str}} animate_opening, tiny_studiolms {{/str}}</label>
</div>
{{> tiny_studiolms/popup_block_width}}
<div class="slms-section-group">
    <div class="slms-section-title">{{#str}} interactivity_sounds, tiny_studiolms {{/str}}</div>
    <div class="d-flex justify-content-between align-items-center mb-2">
        <label for="pop_acc_hover" class="form-label m-0 small">{{#str}} hover_effect, tiny_studiolms {{/str}}</label>
        <select class="form-select form-select-sm slms-select-compact" id="pop_acc_hover">
            <option value="none" {{#hover_none}}selected{{/hover_none}}>{{#str}} hover_none, tiny_studiolms {{/str}}</option>
            <option value="scale" {{#hover_scale}}selected{{/hover_scale}}>{{#str}} hover_scale, tiny_studiolms {{/str}}</option>
            <option value="glow" {{#hover_glow}}selected{{/hover_glow}}>{{#str}} hover_glow, tiny_studiolms {{/str}}</option>
            <option value="lift" {{#hover_lift}}selected{{/hover_lift}}>{{#str}} hover_lift, tiny_studiolms {{/str}}</option>
        </select>
    </div>
    <div class="d-flex justify-content-between align-items-center">
        <label for="pop_acc_sound" class="form-label m-0 small">{{#str}} open_sound, tiny_studiolms {{/str}}</label>
        <select class="form-select form-select-sm slms-select-compact" id="pop_acc_sound">
            <option value="none" {{#sound_opt_none}}selected{{/sound_opt_none}}>{{#str}} sound_opt_none, tiny_studiolms {{/str}}</option>
            <option value="click" {{#sound_opt_click}}selected{{/sound_opt_click}}>{{#str}} sound_opt_click, tiny_studiolms {{/str}}</option>
            <option value="chime" {{#sound_opt_chime}}selected{{/sound_opt_chime}}>{{#str}} sound_opt_chime, tiny_studiolms {{/str}}</option>
            <option value="pop" {{#sound_opt_pop}}selected{{/sound_opt_pop}}>{{#str}} sound_opt_pop, tiny_studiolms {{/str}}</option>
        </select>
    </div>
</div>

<hr class="my-2"/>

<div>
    <span class="form-label small fw-semibold d-block mb-2">
        ✨ {{#str}}accordion_ai_section, tiny_studiolms{{/str}}
    </span>
    <textarea id="accordion_ai_prompt"
              class="form-control form-control-sm"
              rows="2"
              placeholder="{{#str}}accordion_ai_prompt, tiny_studiolms{{/str}}"></textarea>
    <div class="d-flex align-items-center mt-2 slms-gap-2">
        <button type="button" class="btn btn-sm btn-primary" id="accordion-ai-btn">
            {{#str}}accordion_ai_generate, tiny_studiolms{{/str}}
        </button>
        <div id="accordion-ai-spinner"
             class="spinner-border spinner-border-sm text-primary d-none"
             role="status"
             aria-hidden="true"></div>
    </div>
    <div id="accordion-ai-error" class="text-danger small mt-1 d-none"></div>
</div>
