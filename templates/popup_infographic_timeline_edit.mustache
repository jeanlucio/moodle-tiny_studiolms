{{!
    @template tiny_studiolms/popup_infographic_timeline_edit

    Edit popup for the StudioLMS infographic timeline block.
    Each item row has a date/period input, a title input and a description input.
    Up to 6 events; blank rows are ignored on render.

    Example context (json):
    {
        "title": "History of the Internet",
        "item1_date": "1969",
        "item1_title": "ARPANET created",
        "item1_description": "First message sent between universities.",
        "item2_date": "1991",
        "item2_title": "World Wide Web",
        "item2_description": "Tim Berners-Lee launches the WWW.",
        "item3_date": "2004",
        "item3_title": "Social Media rise",
        "item3_description": "Facebook and YouTube launch.",
        "item4_date": "",
        "item4_title": "",
        "item4_description": "",
        "item5_date": "",
        "item5_title": "",
        "item5_description": "",
        "item6_date": "",
        "item6_title": "",
        "item6_description": "",
        "themeBlue": true,
        "themeGreen": false,
        "themePurple": false,
        "themeOrange": false,
        "themeRed": false,
        "themeBlack": false
    }
}}
<div class="slms-popup-infographic-timeline-edit">

    {{! Optional title }}
    <div class="mb-2">
        <label for="tl_title" class="form-label small fw-semibold">
            {{#str}}infographic_timeline_title, tiny_studiolms{{/str}}
        </label>
        <input type="text"
               id="tl_title"
               class="form-control form-control-sm"
               value="{{title}}"
               maxlength="80"/>
    </div>

    {{! Event rows: [date] [title] / [description] }}
    <div class="mb-2">
        <span class="form-label small fw-semibold d-block mb-1">
            {{#str}}infographic_timeline_items, tiny_studiolms{{/str}}
        </span>

        {{! Item 1 }}
        <div class="slms-tl-item-row">
            <div class="slms-tl-date-title-row">
                <input type="text"
                       id="tl_item1_date"
                       class="form-control form-control-sm slms-tl-date-input"
                       value="{{item1_date}}"
                       placeholder="{{#str}}infographic_timeline_item_date_ph, tiny_studiolms{{/str}}"
                       aria-label="{{#str}}infographic_timeline_item_date, tiny_studiolms{{/str}} 1"
                       maxlength="20"/>
                <input type="text"
                       id="tl_item1_title"
                       class="form-control form-control-sm"
                       value="{{item1_title}}"
                       placeholder="{{#str}}infographic_timeline_item_title_ph, tiny_studiolms{{/str}}"
                       aria-label="{{#str}}infographic_timeline_item_title, tiny_studiolms{{/str}} 1"/>
            </div>
            <input type="text"
                   id="tl_item1_description"
                   class="form-control form-control-sm slms-st-desc-input"
                   value="{{item1_description}}"
                   placeholder="{{#str}}infographic_timeline_item_description_ph, tiny_studiolms{{/str}}"
                   aria-label="{{#str}}infographic_timeline_item_description, tiny_studiolms{{/str}} 1"/>
        </div>

        {{! Item 2 }}
        <div class="slms-tl-item-row">
            <div class="slms-tl-date-title-row">
                <input type="text"
                       id="tl_item2_date"
                       class="form-control form-control-sm slms-tl-date-input"
                       value="{{item2_date}}"
                       placeholder="{{#str}}infographic_timeline_item_date_ph, tiny_studiolms{{/str}}"
                       aria-label="{{#str}}infographic_timeline_item_date, tiny_studiolms{{/str}} 2"
                       maxlength="20"/>
                <input type="text"
                       id="tl_item2_title"
                       class="form-control form-control-sm"
                       value="{{item2_title}}"
                       placeholder="{{#str}}infographic_timeline_item_title_ph, tiny_studiolms{{/str}}"
                       aria-label="{{#str}}infographic_timeline_item_title, tiny_studiolms{{/str}} 2"/>
            </div>
            <input type="text"
                   id="tl_item2_description"
                   class="form-control form-control-sm slms-st-desc-input"
                   value="{{item2_description}}"
                   placeholder="{{#str}}infographic_timeline_item_description_ph, tiny_studiolms{{/str}}"
                   aria-label="{{#str}}infographic_timeline_item_description, tiny_studiolms{{/str}} 2"/>
        </div>

        {{! Item 3 }}
        <div class="slms-tl-item-row">
            <div class="slms-tl-date-title-row">
                <input type="text"
                       id="tl_item3_date"
                       class="form-control form-control-sm slms-tl-date-input"
                       value="{{item3_date}}"
                       placeholder="{{#str}}infographic_timeline_item_date_ph, tiny_studiolms{{/str}}"
                       aria-label="{{#str}}infographic_timeline_item_date, tiny_studiolms{{/str}} 3"
                       maxlength="20"/>
                <input type="text"
                       id="tl_item3_title"
                       class="form-control form-control-sm"
                       value="{{item3_title}}"
                       placeholder="{{#str}}infographic_timeline_item_title_ph, tiny_studiolms{{/str}}"
                       aria-label="{{#str}}infographic_timeline_item_title, tiny_studiolms{{/str}} 3"/>
            </div>
            <input type="text"
                   id="tl_item3_description"
                   class="form-control form-control-sm slms-st-desc-input"
                   value="{{item3_description}}"
                   placeholder="{{#str}}infographic_timeline_item_description_ph, tiny_studiolms{{/str}}"
                   aria-label="{{#str}}infographic_timeline_item_description, tiny_studiolms{{/str}} 3"/>
        </div>

        {{! Item 4 }}
        <div class="slms-tl-item-row">
            <div class="slms-tl-date-title-row">
                <input type="text"
                       id="tl_item4_date"
                       class="form-control form-control-sm slms-tl-date-input"
                       value="{{item4_date}}"
                       placeholder="{{#str}}infographic_timeline_item_date_ph, tiny_studiolms{{/str}}"
                       aria-label="{{#str}}infographic_timeline_item_date, tiny_studiolms{{/str}} 4"
                       maxlength="20"/>
                <input type="text"
                       id="tl_item4_title"
                       class="form-control form-control-sm"
                       value="{{item4_title}}"
                       placeholder="{{#str}}infographic_timeline_item_title_ph, tiny_studiolms{{/str}}"
                       aria-label="{{#str}}infographic_timeline_item_title, tiny_studiolms{{/str}} 4"/>
            </div>
            <input type="text"
                   id="tl_item4_description"
                   class="form-control form-control-sm slms-st-desc-input"
                   value="{{item4_description}}"
                   placeholder="{{#str}}infographic_timeline_item_description_ph, tiny_studiolms{{/str}}"
                   aria-label="{{#str}}infographic_timeline_item_description, tiny_studiolms{{/str}} 4"/>
        </div>

        {{! Item 5 }}
        <div class="slms-tl-item-row">
            <div class="slms-tl-date-title-row">
                <input type="text"
                       id="tl_item5_date"
                       class="form-control form-control-sm slms-tl-date-input"
                       value="{{item5_date}}"
                       placeholder="{{#str}}infographic_timeline_item_date_ph, tiny_studiolms{{/str}}"
                       aria-label="{{#str}}infographic_timeline_item_date, tiny_studiolms{{/str}} 5"
                       maxlength="20"/>
                <input type="text"
                       id="tl_item5_title"
                       class="form-control form-control-sm"
                       value="{{item5_title}}"
                       placeholder="{{#str}}infographic_timeline_item_title_ph, tiny_studiolms{{/str}}"
                       aria-label="{{#str}}infographic_timeline_item_title, tiny_studiolms{{/str}} 5"/>
            </div>
            <input type="text"
                   id="tl_item5_description"
                   class="form-control form-control-sm slms-st-desc-input"
                   value="{{item5_description}}"
                   placeholder="{{#str}}infographic_timeline_item_description_ph, tiny_studiolms{{/str}}"
                   aria-label="{{#str}}infographic_timeline_item_description, tiny_studiolms{{/str}} 5"/>
        </div>

        {{! Item 6 — optional }}
        <div class="slms-tl-item-row">
            <div class="slms-tl-date-title-row">
                <input type="text"
                       id="tl_item6_date"
                       class="form-control form-control-sm slms-tl-date-input"
                       value="{{item6_date}}"
                       placeholder="{{#str}}infographic_timeline_item_date_ph, tiny_studiolms{{/str}}"
                       aria-label="{{#str}}infographic_timeline_item_date, tiny_studiolms{{/str}} 6"
                       maxlength="20"/>
                <input type="text"
                       id="tl_item6_title"
                       class="form-control form-control-sm"
                       value="{{item6_title}}"
                       placeholder="{{#str}}infographic_timeline_item_title_ph, tiny_studiolms{{/str}}"
                       aria-label="{{#str}}infographic_timeline_item_title, tiny_studiolms{{/str}} 6"/>
            </div>
            <input type="text"
                   id="tl_item6_description"
                   class="form-control form-control-sm slms-st-desc-input"
                   value="{{item6_description}}"
                   placeholder="{{#str}}infographic_timeline_item_description_ph, tiny_studiolms{{/str}}"
                   aria-label="{{#str}}infographic_timeline_item_description, tiny_studiolms{{/str}} 6"/>
        </div>
    </div>

    {{! Theme picker }}
    <div class="mb-2">
        <span class="form-label small fw-semibold d-block mb-1">
            {{#str}}infographic_theme, tiny_studiolms{{/str}}
        </span>
        <div class="d-flex align-items-center" style="gap:8px;">
            <button type="button"
                    class="slms-ig-theme-btn{{#themeBlue}} selected{{/themeBlue}}"
                    data-theme="blue"
                    aria-label="{{#str}}infographic_theme_blue, tiny_studiolms{{/str}}"
                    style="background:#1d4ed8;">
            </button>
            <button type="button"
                    class="slms-ig-theme-btn{{#themeGreen}} selected{{/themeGreen}}"
                    data-theme="green"
                    aria-label="{{#str}}infographic_theme_green, tiny_studiolms{{/str}}"
                    style="background:#15803d;">
            </button>
            <button type="button"
                    class="slms-ig-theme-btn{{#themePurple}} selected{{/themePurple}}"
                    data-theme="purple"
                    aria-label="{{#str}}infographic_theme_purple, tiny_studiolms{{/str}}"
                    style="background:#7c3aed;">
            </button>
            <button type="button"
                    class="slms-ig-theme-btn{{#themeOrange}} selected{{/themeOrange}}"
                    data-theme="orange"
                    aria-label="{{#str}}infographic_theme_orange, tiny_studiolms{{/str}}"
                    style="background:#c2410c;">
            </button>
            <button type="button"
                    class="slms-ig-theme-btn{{#themeRed}} selected{{/themeRed}}"
                    data-theme="red"
                    aria-label="{{#str}}infographic_theme_red, tiny_studiolms{{/str}}"
                    style="background:#be123c;">
            </button>
            <button type="button"
                    class="slms-ig-theme-btn{{#themeBlack}} selected{{/themeBlack}}"
                    data-theme="black"
                    aria-label="{{#str}}infographic_theme_black, tiny_studiolms{{/str}}"
                    style="background:#0f172a;">
            </button>
        </div>
    </div>

    <hr class="my-2"/>

    {{! AI generation }}
    <div>
        <span class="form-label small fw-semibold d-block mb-1">
            ✨ {{#str}}infographic_ai_section, tiny_studiolms{{/str}}
        </span>
        <textarea id="tl_ai_prompt"
                  class="form-control form-control-sm"
                  rows="2"
                  placeholder="{{#str}}infographic_timeline_ai_prompt, tiny_studiolms{{/str}}"></textarea>
        <div class="d-flex align-items-center mt-2" style="gap:8px;">
            <button type="button" class="btn btn-sm btn-primary" id="tl-ai-btn">
                {{#str}}infographic_ai_generate, tiny_studiolms{{/str}}
            </button>
            <div id="tl-ai-spinner"
                 class="spinner-border spinner-border-sm text-primary d-none"
                 role="status"
                 aria-hidden="true"></div>
        </div>
        <div id="tl-ai-error" class="text-danger small mt-1 d-none"></div>
    </div>

</div>
