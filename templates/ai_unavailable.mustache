{{!
    @template tiny_studiolms/ai_unavailable
    @copyright 2026 Jean Lúcio <jeanlucio@gmail.com>

    Panel shown in an AI tab when neither local_aihub nor core_ai can serve the teacher here.
    The link opens in a new tab so the unsaved canvas in the editor modal is never lost.

    Context variables:
    * aihubkeysurl - AI Hub personal-keys page URL, or empty when the teacher cannot use it.

    Example context (json): {"aihubkeysurl": "https://example.com/local/aihub/mykeys.php"}
}}
<div class="p-4">
    <div class="alert alert-warning mb-0" role="alert">
        <p class="mb-0">
            <span aria-hidden="true">🔑</span>
            <span class="ms-1">{{#str}} ai_generator_no_config, tiny_studiolms {{/str}}</span>
        </p>
        {{#aihubkeysurl}}
        <p class="mt-2 mb-0">
            <a href="{{aihubkeysurl}}" target="_blank" rel="noopener">{{#str}} ai_unavailable_mykeys, tiny_studiolms {{/str}}</a>
        </p>
        {{/aihubkeysurl}}
    </div>
</div>
