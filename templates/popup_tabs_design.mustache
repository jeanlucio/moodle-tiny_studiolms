{{!
    @template tiny_studiolms/popup_tabs_design
    @copyright 2026 Jean Lúcio

    Example context (json): {"accent": "#0d47a1", "count2": false, "count3": true, "count4": false, "count5": false}
}}
<div class="mb-3">
    <label for="pop_tabs_count" class="form-label small fw-bold">{{#str}} tabs_count, tiny_studiolms {{/str}}</label>
    <select class="form-select form-select-sm" id="pop_tabs_count">
        <option value="2" {{#count2}}selected{{/count2}}>2</option>
        <option value="3" {{#count3}}selected{{/count3}}>3</option>
        <option value="4" {{#count4}}selected{{/count4}}>4</option>
        <option value="5" {{#count5}}selected{{/count5}}>5</option>
    </select>
    <div class="form-text small">{{#str}} tabs_count_hint, tiny_studiolms {{/str}}</div>
</div>
<div class="d-flex justify-content-between align-items-center">
    <label for="pop_tabs_accent" class="form-label m-0 small fw-bold">{{#str}} block_color, tiny_studiolms {{/str}}</label>
    <input type="color" class="slms-color-picker" id="pop_tabs_accent" value="{{accent}}">
</div>
{{> tiny_studiolms/popup_block_width}}
