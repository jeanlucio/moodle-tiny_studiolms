{{!
    @template tiny_studiolms/popup_accordion_content
    @copyright 2026 Jean Lúcio <jeanlucio@gmail.com>

    Example context (json): {}
}}
<div class="mb-3">
    <label for="pop_acc_title" class="form-label small fw-bold">{{#str}} title, tiny_studiolms {{/str}}</label>
    <input type="text" class="form-control form-control-sm" id="pop_acc_title" value="{{title}}">
</div>
<div class="mb-1">
    <label for="pop_acc_state" class="form-label small fw-bold">{{#str}} initial_state, tiny_studiolms {{/str}}</label>
    <select class="form-select form-select-sm" id="pop_acc_state">
        <option value="closed" {{#isClosed}}selected{{/isClosed}}>{{#str}} state_closed, tiny_studiolms {{/str}}</option>
        <option value="open" {{#isOpen}}selected{{/isOpen}}>{{#str}} state_open, tiny_studiolms {{/str}}</option>
    </select>
</div>

<hr class="my-2"/>

<div>
    <span class="form-label small fw-semibold d-block mb-2">
        ✨ {{#str}}accordion_ai_section, tiny_studiolms{{/str}}
    </span>
    <textarea id="accordion_ai_prompt"
              class="form-control form-control-sm"
              rows="2"
              placeholder="{{#str}}accordion_ai_prompt, tiny_studiolms{{/str}}"></textarea>
    <div class="d-flex align-items-center mt-2" style="gap:8px;">
        <button type="button" class="btn btn-sm btn-primary" id="accordion-ai-btn">
            {{#str}}accordion_ai_generate, tiny_studiolms{{/str}}
        </button>
        <div id="accordion-ai-spinner"
             class="spinner-border spinner-border-sm text-primary d-none"
             role="status"
             aria-hidden="true"></div>
    </div>
    <div id="accordion-ai-error" class="text-danger small mt-1 d-none"></div>
</div>
