{{!
    @template tiny_studiolms/block_card
    @copyright 2026 Jean Lúcio

    Example context (json): {
        "bg": "#ffffff", "text": "#333333", "border": "#0d47a1", "radius": "8", "shadowClass": "slms-shadow-md",
        "hasMedia": true, "isImage": true, "isImagePlaceholder": false, "mediaUrl": "https://picsum.photos/600/300",
        "isHorizontal": false, "mediaEnd": false, "accent": true, "hasButton": true, "btnText": "Click", "btnUrl": "#",
        "btnBg": "#0d47a1", "btnTextCol": "#fff", "isAlignCenter": true, "btnDisplayMode": "inline-flex"
    }
}}
<div class="studiolms-card-wrap" contenteditable="false">
    <div class="studiolms-card slms-hov-{{hoverEffect}}{{#shadowClass}} {{shadowClass}}{{/shadowClass}} {{#isHorizontal}}slms-horizontal{{/isHorizontal}}{{#mediaEnd}} slms-media-end{{/mediaEnd}}{{^accent}} slms-no-accent{{/accent}}"
         style="background-color: {{bg}}; color: {{text}};{{#accent}} border-left-color: {{border}};{{/accent}} border-radius: {{radius}}px;">
        {{#hasMedia}}
        <div class="studiolms-card-media">
            {{#isImage}}
                <img src="{{mediaUrl}}" alt="" class="w-100 h-100 object-fit-cover d-block">
            {{/isImage}}
            {{#isImagePlaceholder}}
                <div class="slms-card-media-placeholder" aria-hidden="true">&#128247;</div>
            {{/isImagePlaceholder}}
            {{#isVideo}}
                <div class="ratio ratio-16x9 h-100">
                    <iframe src="{{mediaUrl}}" title="{{#str}} video_file, tiny_studiolms {{/str}}" allowfullscreen></iframe>
                </div>
            {{/isVideo}}
        </div>
        {{/hasMedia}}
        <div class="studiolms-card-content">
            <div class="studiolms-editable-area flex-grow-1" contenteditable="true">
                {{{content}}}
            </div>
            {{#hasButton}}
            <div class="mt-4{{#isAlignLeft}} text-start{{/isAlignLeft}}{{#isAlignCenter}} text-center{{/isAlignCenter}}{{#isAlignRight}} text-end{{/isAlignRight}}" contenteditable="false">
                <a href="{{btnUrl}}" class="studiolms-btn slms-hov-{{btnHoverEffect}} slms-snd-{{btnClickSound}}"
                   target="_blank" rel="noopener noreferrer"
                   style="width: {{#isBtnFullWidth}}100%{{/isBtnFullWidth}}{{^isBtnFullWidth}}auto{{/isBtnFullWidth}}; background-color: {{btnBg}}; color: {{btnTextCol}}; border-radius: {{radius}}px;">
                    {{btnText}}
                </a>
            </div>
            {{/hasButton}}
        </div>
    </div>
</div>
<p><br></p>
