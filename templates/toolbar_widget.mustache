{{!
    @template tiny_studiolms/toolbar_widget
    @copyright 2026 Jean Lúcio

    Toolbar of a widget block: what the widget shows and, for the ones that have them, the button of the options.

    Example context (json): {"hasOptions": true, "note": "Shows the sections of the course as a path."}
}}
<div class="slms-toolbar-seg">
    {{#hasOptions}}
    <button type="button" class="slms-toolbar-btn" id="tb-widget-options">
        <i class="fa-solid fa-sliders" aria-hidden="true"></i>
        {{#str}} toolbar_widget_options, tiny_studiolms {{/str}}
    </button>
    {{/hasOptions}}
    <span class="slms-toolbar-note small">{{note}}</span>
</div>
