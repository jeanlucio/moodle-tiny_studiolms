{{!
    @template tiny_studiolms/block_mindmap

    Renders the SVG mind map block injected by the StudioLMS plugin.

    Example context (json):
    {
        "svgContent": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 100 100\"><rect width=\"100\" height=\"100\" fill=\"#f0f9ff\" rx=\"4\"/></svg>"
    }
}}
<div class="slms-block slms-mindmap-block">
    {{{svgContent}}}
</div>
