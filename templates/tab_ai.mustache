{{!
    @template tiny_studiolms/tab_ai
    @copyright 2026 Jean Lúcio <jeanlucio@gmail.com>

    Example context (json): {}
}}
<div class="slms-ai-tab p-4">
    <div class="mb-3">
        <h6 class="fw-bold mb-1">{{#str}} ai_generator_title, tiny_studiolms {{/str}}</h6>
        <p class="text-muted small mb-0">{{#str}} ai_generator_desc, tiny_studiolms {{/str}}</p>
    </div>
    <div class="mb-3">
        <textarea id="slms-ai-prompt"
                  class="form-control form-control-sm"
                  rows="4"
                  aria-label="{{#str}} ai_generator_title, tiny_studiolms {{/str}}"
                  placeholder="{{#str}} ai_generator_placeholder, tiny_studiolms {{/str}}"></textarea>
    </div>
    <div class="d-flex align-items-center gap-2">
        <button type="button" id="slms-ai-generate" class="btn btn-sm btn-primary">
            <span aria-hidden="true">✨</span>
            <span class="ms-1">{{#str}} ai_generate, tiny_studiolms {{/str}}</span>
        </button>
        <span id="slms-ai-spinner" class="d-none" aria-live="polite">
            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
            <span class="ms-1 small text-muted">{{#str}} ai_generating, tiny_studiolms {{/str}}</span>
        </span>
    </div>
    <div id="slms-ai-error" class="mt-2 text-danger small" role="alert" aria-live="assertive"></div>
</div>
