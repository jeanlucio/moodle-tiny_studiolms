{{!
    @template tiny_studiolms/popup_widget_coursemap
    @copyright 2026 Jean Lúcio

    Options of the course map widget, written inside its marker.

    Example context (json): {"currentDate": true, "currentProgress": false, "styleAuto": true, "styleSteps": false, "styleTiles": false}
}}
<div class="mb-3">
    <label for="pop_widget_current" class="form-label small fw-bold">{{#str}} widget_current_label, tiny_studiolms {{/str}}</label>
    <select class="form-select form-select-sm" id="pop_widget_current">
        <option value="date" {{#currentDate}}selected{{/currentDate}}>{{#str}} widget_current_date, tiny_studiolms {{/str}}</option>
        <option value="progress" {{#currentProgress}}selected{{/currentProgress}}>{{#str}} widget_current_progress, tiny_studiolms {{/str}}</option>
    </select>
    <div class="form-text small">{{#str}} widget_current_hint, tiny_studiolms {{/str}}</div>
</div>
<div class="mb-3">
    <label for="pop_widget_style" class="form-label small fw-bold">{{#str}} widget_style_label, tiny_studiolms {{/str}}</label>
    <select class="form-select form-select-sm" id="pop_widget_style">
        <option value="auto" {{#styleAuto}}selected{{/styleAuto}}>{{#str}} widget_style_auto, tiny_studiolms {{/str}}</option>
        <option value="steps" {{#styleSteps}}selected{{/styleSteps}}>{{#str}} widget_style_steps, tiny_studiolms {{/str}}</option>
        <option value="tiles" {{#styleTiles}}selected{{/styleTiles}}>{{#str}} widget_style_tiles, tiny_studiolms {{/str}}</option>
    </select>
    <div class="form-text small">{{#str}} widget_style_hint, tiny_studiolms {{/str}}</div>
</div>
