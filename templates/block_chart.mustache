{{!
    @template tiny_studiolms/block_chart

    Renders the chart block inserted by the StudioLMS plugin: a stacked bar, one segment per slice, and a legend.
    Plain HTML with a class per colour and a width in percent, so it survives the HTML cleaner of the forum, the
    glossary, the questions and the assignments.

    Example context (json):
    {
        "title": "Resultado do Curso",
        "slices": [
            {"label": "Aprovados", "pct": 75, "width": 75, "color": 1},
            {"label": "Em progresso", "pct": 15, "width": 15, "color": 2},
            {"label": "Reprovados", "pct": 10, "width": 10, "color": 3}
        ]
    }
}}
<div class="slms-block slms-chart-block slms-align-{{align}}{{#hoverEffect}} slms-hov-{{hoverEffect}}{{/hoverEffect}}">
    {{#title}}<div class="slms-chart__title">{{title}}</div>{{/title}}
    <div class="slms-chart__stack">
        {{#slices}}
        <div class="slms-chart__segment slms-bar-c{{color}}" style="width: {{width}}%"></div>
        {{/slices}}
    </div>
    <div class="slms-chart__legend">
        {{#slices}}
        <div class="slms-chart__legend-item">
            <span class="slms-chart__legend-dot slms-bar-c{{color}}"></span>
            <span class="slms-chart__legend-label">{{label}}</span>
            <span class="slms-chart__legend-pct">{{pct}}%</span>
        </div>
        {{/slices}}
    </div>
</div>
