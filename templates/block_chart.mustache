{{!
    @template tiny_studiolms/block_chart

    Renders a pie or donut chart block inserted by the StudioLMS plugin.
    The `svg` and `legend` triple-staches carry pre-built markup generated by chart.js.

    Example context (json):
    {
        "type": "donut",
        "title": "Resultado do Curso",
        "svg": "<svg viewBox=\"0 0 280 280\" role=\"img\" xmlns=\"http://www.w3.org/2000/svg\" class=\"slms-chart__svg\"><path d=\"M 140.00 22.00 A 118 118 0 1 1 69.50 234.22 L 96.75 190.11 A 56 56 0 1 0 140.00 84.00 Z\" fill=\"#3b82f6\" aria-label=\"Aprovados: 75%\"/></svg>",
        "legend": "<div class=\"slms-chart__legend\"><div class=\"slms-chart__legend-item\"><span class=\"slms-chart__legend-dot\" style=\"background:#3b82f6;\" aria-hidden=\"true\"></span><span class=\"slms-chart__legend-label\">Aprovados</span><span class=\"slms-chart__legend-pct\">75%</span></div></div>"
    }
}}
<div class="slms-block slms-chart-block slms-chart--{{type}}">
    {{#title}}<div class="slms-chart__title">{{title}}</div>{{/title}}
    <div class="slms-chart__body">
        <div class="slms-chart__wrap">
            {{{svg}}}
        </div>
        {{{legend}}}
    </div>
</div>
