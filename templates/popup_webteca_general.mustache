{{!
    @template tiny_studiolms/popup_webteca_general
    @copyright 2026 Jean Lúcio <jeanlucio@gmail.com>

    Example context (json): {}
}}
<div class="mb-3 pb-3 border-bottom">
    <label for="pop_web_layout" class="form-label small fw-bold">{{#str}} layout, tiny_studiolms {{/str}}</label>
    <select class="form-select form-select-sm" id="pop_web_layout">
        <option value="list" {{#isList}}selected{{/isList}}>{{#str}} layout_list, tiny_studiolms {{/str}}</option>
        <option value="grid" {{#isGrid}}selected{{/isGrid}}>{{#str}} layout_grid, tiny_studiolms {{/str}}</option>
    </select>
</div>
<div class="mb-3">
    <label for="pop_web_title" class="form-label small fw-bold">{{#str}} webteca_title, tiny_studiolms {{/str}}</label>
    <input type="text" class="form-control form-control-sm" id="pop_web_title" value="{{title}}">
</div>
<div class="mb-3">
    <label for="pop_web_desc" class="form-label small fw-bold">{{#str}} webteca_desc, tiny_studiolms {{/str}}</label>
    <textarea class="form-control form-control-sm" id="pop_web_desc" rows="2">{{desc}}</textarea>
</div>
<div class="d-flex justify-content-between align-items-center mb-3">
    <label for="pop_web_bg" class="form-label m-0 small fw-bold">{{#str}} bg_color, tiny_studiolms {{/str}}</label>
    <input type="color" class="slms-color-picker" id="pop_web_bg" value="{{bg}}">
</div>
<div class="d-flex justify-content-between align-items-center pb-3 border-bottom">
    <label for="pop_web_open" class="form-label m-0 small fw-bold">{{#str}} initial_state, tiny_studiolms {{/str}}</label>
    <select class="form-select form-select-sm slms-select-compact" id="pop_web_open">
        <option value="true" {{#isOpen}}selected{{/isOpen}}>{{#str}} state_open, tiny_studiolms {{/str}}</option>
        <option value="false" {{^isOpen}}selected{{/isOpen}}>{{#str}} state_closed, tiny_studiolms {{/str}}</option>
    </select>
</div>
<hr class="my-2"/>

<div class="mb-3">
    <span class="form-label small fw-semibold d-block mb-2">
        ✨ {{#str}}webteca_ai_section, tiny_studiolms{{/str}}
    </span>
    <textarea id="webteca_ai_prompt"
              class="form-control form-control-sm"
              rows="2"
              placeholder="{{#str}}webteca_ai_prompt, tiny_studiolms{{/str}}"></textarea>
    <div class="d-flex align-items-center mt-2" style="gap:8px;">
        <button type="button" class="btn btn-sm btn-primary" id="webteca-ai-btn">
            {{#str}}webteca_ai_generate, tiny_studiolms{{/str}}
        </button>
        <div id="webteca-ai-spinner"
             class="spinner-border spinner-border-sm text-primary d-none"
             role="status"
             aria-hidden="true"></div>
    </div>
    <div id="webteca-ai-error" class="text-danger small mt-1 d-none"></div>
</div>

<div class="slms-section-group">
    <div class="slms-section-title">{{#str}} interactivity_sounds, tiny_studiolms {{/str}}</div>
    <div class="d-flex justify-content-between align-items-center mb-2">
        <label for="pop_web_hover" class="form-label m-0 small">{{#str}} hover_effect, tiny_studiolms {{/str}}</label>
        <select class="form-select form-select-sm slms-select-compact" id="pop_web_hover">
            <option value="none" {{#hover_none}}selected{{/hover_none}}>{{#str}} hover_none, tiny_studiolms {{/str}}</option>
            <option value="scale" {{#hover_scale}}selected{{/hover_scale}}>{{#str}} hover_scale, tiny_studiolms {{/str}}</option>
            <option value="glow" {{#hover_glow}}selected{{/hover_glow}}>{{#str}} hover_glow, tiny_studiolms {{/str}}</option>
            <option value="lift" {{#hover_lift}}selected{{/hover_lift}}>{{#str}} hover_lift, tiny_studiolms {{/str}}</option>
        </select>
    </div>
    <div class="d-flex justify-content-between align-items-center">
        <label for="pop_web_sound" class="form-label m-0 small">{{#str}} open_sound, tiny_studiolms {{/str}}</label>
        <select class="form-select form-select-sm slms-select-compact" id="pop_web_sound">
            <option value="none" {{#sound_opt_none}}selected{{/sound_opt_none}}>{{#str}} sound_opt_none, tiny_studiolms {{/str}}</option>
            <option value="click" {{#sound_opt_click}}selected{{/sound_opt_click}}>{{#str}} sound_opt_click, tiny_studiolms {{/str}}</option>
            <option value="chime" {{#sound_opt_chime}}selected{{/sound_opt_chime}}>{{#str}} sound_opt_chime, tiny_studiolms {{/str}}</option>
            <option value="pop" {{#sound_opt_pop}}selected{{/sound_opt_pop}}>{{#str}} sound_opt_pop, tiny_studiolms {{/str}}</option>
        </select>
    </div>
</div>
