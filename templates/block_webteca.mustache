{{!
    @template tiny_studiolms/block_webteca
    @copyright 2026 Jean Lúcio <jeanlucio@gmail.com>

    Example context (json): {
        "bg": "#ffffff", "headerBg": "#f8f9fa", "color": "#0d47a1", "title": "Title", "desc": "Desc",
        "listFlexDirection": "column", "listFlexWrap": "nowrap",
        "mappedResources": [{"url": "#", "typeColor": "#0d6efd", "icon": "🔗", "title": "Resource"}]
    }
}}
<div class="studiolms-webteca-wrap my-4 w-100" style="max-width: 900px;">
    <details class="studiolms-webteca" open style="--slms-bg: {{bg}};">
        <summary class="studiolms-webteca-summary" style="--slms-header-bg: {{headerBg}};">
            <span class="d-flex flex-column gap-1">
                <span class="fw-bold fs-5" style="color: {{color}};">
                    <span aria-hidden="true" class="me-2">📚</span><span class="slms-wt-title">{{title}}</span>
                </span>
                <span class="slms-wt-desc text-secondary small">{{desc}}</span>
            </span>
            <span contenteditable="false" aria-hidden="true" class="ms-3 fs-5 user-select-none" style="color: {{color}};">▼</span>
        </summary>
        <div contenteditable="false" class="p-4">
            <ul class="studiolms-webteca-list" style="--slms-dir: {{listFlexDirection}}; --slms-wrap: {{listFlexWrap}};">
                {{#mappedResources}}
                <li style="{{#isGrid}}flex: 1 1 calc(50% - 0.75rem); min-width: 250px;{{/isGrid}}">
                    <a href="{{url}}" target="_blank" rel="noopener noreferrer" class="studiolms-webteca-item" style="--slms-type-c: {{typeColor}};">
                        <span aria-hidden="true" class="me-3 fs-5">{{icon}}</span>
                        <span class="flex-grow-1">{{title}}</span>
                        <span class="badge bg-light text-dark border">{{#str}} webteca_btn_access, tiny_studiolms {{/str}}</span>
                    </a>
                </li>
                {{/mappedResources}}
                {{^mappedResources}}
                <li class="p-3 text-center text-muted fst-italic bg-white rounded border border-dashed w-100">
                    {{#str}} no_resources, tiny_studiolms {{/str}}
                </li>
                {{/mappedResources}}
            </ul>
        </div>
    </details>
</div>
<p><br></p>
