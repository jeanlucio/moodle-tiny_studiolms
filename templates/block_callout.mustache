{{!
    @template tiny_studiolms/block_callout
    @copyright 2026 Jean Lúcio <jeanlucio@gmail.com>

    Example context (json): {
        "backgroundColor": "#fef9c3", "borderLeftWidth": 4, "borderColor": "#eab308",
        "borderRadius": 6, "hasIcon": true, "icon": "💡", "textColor": "#854d0e", "contentHtml": "<p>Cont</p>"
    }
}}
<div class="studiolms-callout-wrap mceNonEditable"
     data-slms-hover="{{hoverEffect}}"
     style="background-color: {{backgroundColor}}; border-left: {{borderLeftWidth}}px solid {{borderColor}}; border-radius: {{borderRadius}}px;">
    {{#hasIcon}}
    <div class="slms-callout-icon" aria-hidden="true">
        {{{icon}}}
    </div>
    {{/hasIcon}}
    <div class="slms-callout-content mceEditable" style="color: {{textColor}};">
        {{{contentHtml}}}
    </div>
</div>
<p><br></p>
