{{!
    @template tiny_studiolms/block_callout
    @copyright 2026 Jean Lúcio <jeanlucio@gmail.com>

    Example context (json): {
        "backgroundColor": "#fef9c3",
        "borderLeftWidth": 4,
        "borderColor": "#eab308",
        "borderRadius": 6,
        "hasIcon": true,
        "icon": "💡",
        "textColor": "#854d0e",
        "contentHtml": "<p>Content</p>"
    }
}}
<div class="studiolms-callout-wrap mceNonEditable" style="background-color: {{backgroundColor}}; border-left: {{borderLeftWidth}}px solid {{borderColor}}; border-radius: {{borderRadius}}px; padding: 16px 20px; display: flex; align-items: flex-start; gap: 16px; margin-bottom: 1.5rem; box-sizing: border-box; width: 100%;">
    {{#hasIcon}}
    <div class="slms-callout-icon" aria-hidden="true" style="font-size: 24px; line-height: 1; flex-shrink: 0; user-select: none;">
        {{{icon}}}
    </div>
    {{/hasIcon}}
    <div class="slms-callout-content mceEditable" style="flex-grow: 1; color: {{textColor}}; font-size: 16px; line-height: 1.5; outline: none; min-width: 0;">
        {{{contentHtml}}}
    </div>
</div>
<p><br></p>
