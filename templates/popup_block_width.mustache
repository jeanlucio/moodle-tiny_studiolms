{{!
    @template tiny_studiolms/popup_block_width
    @copyright 2026 Jean Lúcio

    Width field shared by the popups of the blocks that a stylesheet caps: reduced (the cap) or the whole column. The
    popup context carries the two flags from widthVars() in amd/src/blocks/block_width.js.

    Example context (json): {"widthReduced": true, "widthFull": false}
}}
<div class="mb-3">
    <label for="pop_block_width" class="form-label small fw-bold">{{#str}} width_label, tiny_studiolms {{/str}}</label>
    <select class="form-select form-select-sm" id="pop_block_width">
        <option value="reduced" {{#widthReduced}}selected{{/widthReduced}}>{{#str}} width_reduced, tiny_studiolms {{/str}}</option>
        <option value="full" {{#widthFull}}selected{{/widthFull}}>{{#str}} width_full, tiny_studiolms {{/str}}</option>
    </select>
    <div class="form-text small">{{#str}} width_hint, tiny_studiolms {{/str}}</div>
</div>
