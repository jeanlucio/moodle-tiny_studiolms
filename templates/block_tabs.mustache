{{!
    @template tiny_studiolms/block_tabs
    @copyright 2026 Jean Lúcio

    The panels come one after the other, each with its title, so the content is all there wherever the script of the
    plugin does not run. On the course page the script builds the row of tabs from the titles.

    Example context (json): {
        "accent": "#0d47a1", "hoverEffect": "none",
        "tabs": [{"title": "Tab 1", "content": "<p>Text</p>"}, {"title": "Tab 2", "content": "<p>More text</p>"}]
    }
}}
<div class="studiolms-tabs-wrap slms-width-{{width}} w-100{{#hoverEffect}} slms-hov-{{hoverEffect}}{{/hoverEffect}}">
    <div class="studiolms-tabs">
        {{#tabs}}
        <div class="studiolms-tab-panel">
            <div class="slms-tab-title slms-single-line" style="color: {{accent}};" contenteditable="true">{{title}}</div>
            <div class="slms-tab-content studiolms-editable-area" contenteditable="true">
                {{{content}}}
            </div>
        </div>
        {{/tabs}}
    </div>
</div>
<p><br></p>
