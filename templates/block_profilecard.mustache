{{!
    @template tiny_studiolms/block_profilecard
    @copyright 2026 Jean Lúcio <jeanlucio@gmail.com>

    Example context (json): {
        "photoUrl": "https://i.pravatar.cc/150",
        "hasPhoto": true,
        "name": "Prof. Jean Lúcio",
        "role": "Designer Instrucional",
        "bio": "Especialista em educação a distância e tecnologias educacionais.",
        "hasLinks": true,
        "links": [
            {"label": "LinkedIn", "url": "https://linkedin.com"},
            {"label": "E-mail", "url": "mailto:prof@exemplo.com"}
        ],
        "bgColor": "#ffffff",
        "accentColor": "#0f6cbf"
    }
}}
<div class="studiolms-profilecard" style="background-color: {{bgColor}}; --slms-pc-accent: {{accentColor}};">
    {{#hasPhoto}}
    <img class="slms-pc-photo" src="{{photoUrl}}" alt="{{name}}">
    {{/hasPhoto}}
    {{^hasPhoto}}
    <div class="slms-pc-photo-placeholder" aria-hidden="true">👤</div>
    {{/hasPhoto}}
    <p class="slms-pc-name">{{name}}</p>
    {{#role}}<p class="slms-pc-role">{{role}}</p>{{/role}}
    {{#bio}}<p class="slms-pc-bio">{{bio}}</p>{{/bio}}
    {{#hasLinks}}
    <div class="slms-pc-links">
        {{#links}}
        <a href="{{url}}" class="slms-pc-link" target="_blank" rel="noopener noreferrer">{{label}}</a>
        {{/links}}
    </div>
    {{/hasLinks}}
</div>
<p><br></p>
