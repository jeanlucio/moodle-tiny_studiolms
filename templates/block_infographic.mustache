{{!
    @template tiny_studiolms/block_infographic

    Renders an infographic block inserted by the StudioLMS plugin.
    The `content` triple-stache carries the pre-built inner HTML (stat cards, etc.)
    generated by the JS renderer for the selected layout.

    Example context (json):
    {
        "layout": "stats",
        "theme": "blue",
        "content": "<div class=\"slms-infographic__grid\"><div class=\"slms-infographic__stat\"><div class=\"slms-infographic__icon\"><i class=\"fa-solid fa-users\" aria-hidden=\"true\"></i></div><div class=\"slms-infographic__value\">85%</div><div class=\"slms-infographic__label\">Taxa de aprovação</div></div></div>"
    }
}}
<div class="slms-block slms-infographic-block slms-infographic--{{layout}} slms-infographic--{{theme}} slms-align-{{align}}{{#hoverEffect}} slms-hov-{{hoverEffect}}{{/hoverEffect}}">
    {{{content}}}
</div>
