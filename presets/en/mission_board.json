{
  "name": "Mission Board",
  "description": "Gamified grid layout to list the week's tasks as missions (Main, Side and Bonus).",
  "blocks": [
    {
      "type": "gridcards",
      "config": {
        "columns": "3",
        "gap": 20,
        "containerTitle": "🛡️ Mission Board",
        "containerDesc": "Complete the objectives below to earn experience and advance in this module.",
        "containerTitleSize": "24px",
        "titleColor": "#333333",
        "background": "#fdfdfd",
        "borderColor": "#e3e3e3",
        "borderWidth": 1,
        "borderRadius": 8,
        "shadow": "none",
        "padding": "md",
        "slots": [
          "<div class=\"studiolms-callout-wrap mceNonEditable slms-hov-none\" style=\"background-color: #fffaf0; border-left: 6px solid #d4af37; border-radius: 8px;\" data-slms-block-type=\"callout\" data-slms-state=\"\">\n    <div class=\"slms-callout-content mceEditable\" style=\"color: #5d4037;\" contenteditable=\"true\">\n        <strong>⚔️ Main Mission</strong><p class=\"m-0 mt-2\"><strong>Objective:</strong> [Describe the essential task. E.g.: Read the core material and set up your local environment]</p><p class=\"m-0 mt-2\"><strong>Reward:</strong> [E.g.: 50 XP and a solid base for the challenges]</p>\n    </div>\n</div>",
          "<div class=\"studiolms-callout-wrap mceNonEditable slms-hov-none\" style=\"background-color: #f8f9fa; border-left: 6px solid #bdc3c7; border-radius: 8px;\" data-slms-block-type=\"callout\" data-slms-state=\"\">\n    <div class=\"slms-callout-content mceEditable\" style=\"color: #2c3e50;\" contenteditable=\"true\">\n        <strong>📜 Side Mission</strong><p class=\"m-0 mt-2\"><strong>Objective:</strong> [Describe the interaction task. E.g.: Join the forum and share your installation experience]</p><p class=\"m-0 mt-2\"><strong>Reward:</strong> [E.g.: 20 XP and networking with the class]</p>\n    </div>\n</div>",
          "<div class=\"studiolms-callout-wrap mceNonEditable slms-hov-none\" style=\"background-color: #fcf8ff; border-left: 6px solid #9b59b6; border-radius: 8px;\" data-slms-block-type=\"callout\" data-slms-state=\"\">\n    <div class=\"slms-callout-content mceEditable\" style=\"color: #4a235a;\" contenteditable=\"true\">\n        <strong>💎 Bonus Mission</strong><p class=\"m-0 mt-2\"><strong>Objective:</strong> [Optional challenge. E.g.: Help a classmate in the forum or try an extra plugin]</p><p class=\"m-0 mt-2\"><strong>Reward:</strong> [E.g.: 'Code Paladin' badge]</p>\n    </div>\n</div>"
        ]
      }
    }
  ]
}
